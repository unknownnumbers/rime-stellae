+      hpipe(r.hpipe),
+      has_body(r.has_body),
+      response_generation(r.response_generation),
+      response_data_valid(r.response_data_valid) {
+  r.hpipe = INVALID_HANDLE_VALUE;
+  r.has_body = false;
+  r.response_data_valid = false;
+}
+
+PipeChannelBase::~PipeChannelBase() {
+  _FinalizePipe(hpipe);
+}
+
+bool PipeChannelBase::_Ensure(DWORD* error) {
+  if (error) *error = ERROR_SUCCESS;
+  try {
+    if (_Invalid(hpipe)) {
+      hpipe = _Connect(pname.c_str());
+      if (_Invalid(hpipe)) {
+        if (error) *error = ERROR_PIPE_NOT_CONNECTED;
+        return false;
+      }
+    }
+  } catch (DWORD failure) {
+    if (error) *error = failure != ERROR_SUCCESS ? failure : ERROR_GEN_FAILURE;
+    return false;
+  } catch (...) {
+    if (error) *error = ERROR_GEN_FAILURE;
+    return false;
+  }
+
+  return true;
+}
+
+HANDLE PipeChannelBase::_Connect(const wchar_t* name) {
+  HANDLE pipe = INVALID_HANDLE_VALUE;
+  while (_Invalid(pipe = _TryConnect()))
+    ::WaitNamedPipe(name, 500);
+  DWORD mode = PIPE_READMODE_MESSAGE;
+  if (!SetNamedPipeHandleState(pipe, &mode, NULL, NULL)) {
+    const DWORD error = ::GetLastError();
+    ::CloseHandle(pipe);
+    throw error;
+  }
+  return pipe;
+}
+
+HANDLE PipeChannelBase::_TryConnect() {
+  auto pipe = ::CreateFile(pname.c_str(), GENERIC_READ | GENERIC_WRITE, 0, NULL,
+                           OPEN_EXISTING, 0, NULL);
+  if (!_Invalid(pipe)) {
+    // connected to the pipe
+    return pipe;
+  }
+  // being busy is not really an error since we just need to wait.
+  _ThrowIfNot(ERROR_PIPE_BUSY);
+  // All pipe instances are busy
+  return INVALID_HANDLE_VALUE;
+}
+
+size_t PipeChannelBase::_WritePipe(HANDLE pipe, size_t s, char* b) {
+  DWORD lwritten = 0;
+  if (!::WriteFile(pipe, b, static_cast<DWORD>(s), &lwritten, NULL)) {
+    _ThrowLastError;
+  }
+  if (lwritten != s) throw DWORD(ERROR_WRITE_FAULT);
+  ::FlushFileBuffers(pipe);
+  return lwritten;
+}
+
+void PipeChannelBase::_FinalizePipe(HANDLE& p) {
+  response_data_valid = false;
+  if (!_Invalid(p)) {
+    DisconnectNamedPipe(p);
+    CloseHandle(p);
+  }
+  p = INVALID_HANDLE_VALUE;
+}
+
+bool PipeChannelBase::_ReceiveInto(HANDLE pipe, LPVOID msg, size_t rec_len,
+                                    char* body, size_t body_size,
+                                    TransactionPhase& phase) {
+  DWORD lread = 0;
+  const BOOL success = ::ReadFile(pipe, msg, static_cast<DWORD>(rec_len), &lread, NULL);
+  const DWORD error = success ? ERROR_SUCCESS : ::GetLastError();
+  if (error != ERROR_SUCCESS && error != ERROR_MORE_DATA) throw error;
+  if (lread != rec_len) throw DWORD(ERROR_INVALID_DATA);
+  phase = TransactionPhase::ReplyHeaderReceived;
+  if (success) return false;
+  memset(body, 0, body_size);
+  if (!::ReadFile(pipe, body, static_cast<DWORD>(body_size), &lread, NULL))
+    _ThrowLastError;
+  if (lread == 0) throw DWORD(ERROR_INVALID_DATA);
+  phase = TransactionPhase::ReplyBodyReceived;
+  return true;
+}
+
+void PipeChannelBase::_Receive(HANDLE pipe, LPVOID msg, size_t rec_len,
+                               TransactionPhase& phase) {
+  response_data_valid = false;
+  if (_ReceiveInto(pipe, msg, rec_len, buffer.get(), buff_size, phase)) {
+    // Zero is reserved for no current body. Preserve identity across reconnects.
+    ++response_generation;
+    response_data_valid = true;
+  }
+  has_body = false;
+}
