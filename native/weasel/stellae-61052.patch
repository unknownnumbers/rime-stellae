+      bool oppositeSeen = false;
+    };
+    std::vector<std::unique_ptr<Entry>> entries;
+
+    bool Present() const { return !entries.empty(); }
+    size_t Find(IUnknown* owner, WPARAM key, LPARAM info, bool forTest = false) const {
+      for (size_t i = 0; i < entries.size(); ++i) {
+        const auto& entry = entries[i];
+        if (entry->owner.p == owner && entry->virtualKey == key &&
+            entry->physicalKey == (info & 0x01ff0000) &&
+            (!forTest || !entry->oppositeSeen)) return i;
+      }
+      return entries.size();
+    }
+    bool Matches(IUnknown* owner, WPARAM key, LPARAM info) const {
+      return owner && Find(owner, key, info, true) != entries.size();
