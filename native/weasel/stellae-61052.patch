+/* Get Text Extent */
+class CGetTextExtentEditSession : public CEditSession {
+ public:
+  CGetTextExtentEditSession(com_ptr<WeaselTSF> service,
+      com_ptr<ITfContext> owner, com_ptr<ITfContextView> view,
+      com_ptr<ITfRange> range,
+      std::shared_ptr<response_owner::Packet> packet,
+      std::shared_ptr<response_owner::Intent> intent)
+      : CEditSession(service, owner), _view(view), _range(range),
+        _packet(packet), _intent(intent) {}
+
+  STDMETHODIMP DoEditSession(TfEditCookie ec);
+
+ private:
+  bool Current() const {
+    return _pTextService->_IsPresentedResponse(_packet) &&
+        _packet->outputIntent.lock() == _intent &&
+        _intent->range.p == _range.p;
+  }
+  HRESULT OwnedScreenBounds(RECT& bounds);
+  com_ptr<ITfContextView> _view;
+  com_ptr<ITfRange> _range;
+  std::shared_ptr<response_owner::Packet> _packet;
+  std::shared_ptr<response_owner::Intent> _intent;
+};
+
+HRESULT CGetTextExtentEditSession::OwnedScreenBounds(RECT& bounds) {
+  HRESULT result = _view->GetScreenExt(&bounds);
+  if (!Current()) return S_FALSE;
+  if (result == S_OK) {
+    // Zero display bounds mean this document is not displayed, not a
+    // request to borrow the foreground window's geometry.
+    return bounds.right > bounds.left && bounds.bottom > bounds.top ? S_OK : S_FALSE;
+  }
+  HWND window = nullptr;
+  result = _view->GetWnd(&window);
+  if (!Current()) return S_FALSE;
+  if (FAILED(result)) return result;
+  if (!window) return S_FALSE;  // Successful windowless GetWnd is valid.
+  if (!::GetWindowRect(window, &bounds)) return HRESULT_FROM_WIN32(GetLastError());
+  if (!Current()) return S_FALSE;
+  return bounds.right > bounds.left && bounds.bottom > bounds.top ? S_OK : S_FALSE;
+}
+
+STDAPI CGetTextExtentEditSession::DoEditSession(TfEditCookie ec) {
+  if (!Current()) return S_FALSE;
+  com_ptr<ITfContextView> active;
+  HRESULT result = _pContext->GetActiveView(&active);
+  if (!Current()) return S_FALSE;
+  if (FAILED(result)) return result;
+  const bool same_view = response_owner::SameIdentity(active, _view);
+  if (!Current() || !same_view) return S_FALSE;
+  com_ptr<ITfContext> range_owner;
+  result = _range->GetContext(&range_owner);
+  if (!Current()) return S_FALSE;
+  if (FAILED(result)) return result;
+  const bool same_owner = response_owner::SameIdentity(range_owner, _pContext);
+  if (!Current() || !same_owner) return S_FALSE;
+  com_ptr<ITfRange> query;
+  result = _range->Clone(&query);
+  if (!Current()) return S_FALSE;
+  if (FAILED(result)) return result;
+  result = query->Collapse(ec, TF_ANCHOR_START);
+  if (!Current()) return S_FALSE;
+  if (FAILED(result)) return result;
+  RECT rect = {};
+  BOOL clipped = FALSE;
+  const HRESULT text_result = _view->GetTextExt(ec, query, &rect, &clipped);
+  if (!Current()) return S_FALSE;
+  const bool has_text_rect = text_result == S_OK &&
+      (rect.left || rect.top || rect.right || rect.bottom);
+  const bool enhanced = _packet->response->style.enhanced_position;
+  RECT bounds = {};
+  const HRESULT bounds_result = enhanced ? OwnedScreenBounds(bounds) : S_FALSE;
+  if (!Current()) return S_FALSE;
+  if (has_text_rect) {
+    if (bounds_result == S_OK &&
+        (rect.left < bounds.left || rect.left > bounds.right ||
+         rect.top < bounds.top || rect.top > bounds.bottom)) {
+      // Retain the existing enhanced-position correction, but translate
+      // only to this view's own display edge. No thread/global caret guess.
+      ::OffsetRect(&rect, bounds.left - rect.left, bounds.top - rect.top);
+    }
+    // Clipped text still has a valid source-owned visible bounding box.
+    return _pTextService->_SetCompositionPosition(_packet, rect, false);
+  }
+  if (bounds_result == S_OK)
+    return _pTextService->_SetCompositionPosition(_packet, bounds, true);
+  // No new rectangle. A good position from this registration may remain;
+  // an unpositioned new registration must not reuse another context's rect.
+  return FAILED(text_result) ? text_result : S_FALSE;
+}
