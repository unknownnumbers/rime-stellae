+#include "stdafx.h"
+#include "WeaselTSF.h"
+#include "Compartment.h"
+#include <resource.h>
+#include <functional>
+#include <cwchar>
+#include <commctrl.h>
+#pragma comment(lib, "comctl32.lib")
+#include "CandidateList.h"
+#include "LanguageBar.h"
+
+namespace {
+const GUID kGlobalNativeOpen = stellae::identity::kGlobalNativeOpenGuid;
+constexpr UINT kApplyGlobalNativeOpen = WM_APP + 0x3a1;
+}  // namespace
+
+struct WeaselTSF::NativeOpenWindowBinding {
+  com_ptr<WeaselTSF> service;
+  std::weak_ptr<ActivationBindings> activation;
+};
+
+LRESULT CALLBACK WeaselTSF::_NativeOpenWindowProc(HWND window, UINT message,
+    WPARAM wParam, LPARAM lParam, UINT_PTR subclass, DWORD_PTR reference) {
+  auto binding = reinterpret_cast<NativeOpenWindowBinding*>(reference);
+  // A nested Apply may destroy this token. Copy both leases before any callout.
+  const com_ptr<WeaselTSF> service = binding->service;
+  const auto activation = binding->activation.lock();
+  if (message == WM_NCDESTROY) {
+    RemoveWindowSubclass(window, _NativeOpenWindowProc, subclass);
+    delete binding;
+    return DefSubclassProc(window, message, wParam, lParam);
+  }
+  if (message == kApplyGlobalNativeOpen) {
+    if (service->_CurrentActivation(activation))
+      service->_ApplyGlobalKeyboardOpen();
+    return 0;
+  }
+  return DefSubclassProc(window, message, wParam, lParam);
+}
+
+HRESULT WeaselTSF::_InitGlobalKeyboardOpen(const Activation& activation) {
+  if (!_CurrentActivation(activation)) return E_UNEXPECTED;
+  const com_ptr<ITfThreadMgr> thread = activation->thread;
+  if (!_CurrentActivation(activation)) return E_UNEXPECTED;
+  // A system class removes custom-class registration/unregistration ownership.
+  HWND window = CreateWindowExW(0, L"STATIC", L"", 0, 0, 0, 0, 0,
+      HWND_MESSAGE, nullptr, g_hInst, nullptr);
+  if (!window) return HRESULT_FROM_WIN32(GetLastError());
+  if (!_CurrentActivation(activation)) { DestroyWindow(window); return E_UNEXPECTED; }
+  auto binding = new NativeOpenWindowBinding{this, activation};
+  if (!SetWindowSubclass(window, _NativeOpenWindowProc, 1,
+          reinterpret_cast<DWORD_PTR>(binding))) {
+    const DWORD error = GetLastError();
+    delete binding;
+    DestroyWindow(window);
+    return error ? HRESULT_FROM_WIN32(error) : E_FAIL;
+  }
+  activation->nativeWindow = window;
+  if (!_CurrentActivation(activation)) {
+    _UninitGlobalKeyboardOpen(*activation);
+    return E_UNEXPECTED;
+  }
+
+  com_ptr<ITfCompartmentMgr> manager;
+  HRESULT result = thread->GetGlobalCompartment(&manager);
+  if (FAILED(result) || !_CurrentActivation(activation))
+    return FAILED(result) ? result : E_UNEXPECTED;
+  com_ptr<ITfCompartment> compartment;
+  result = manager->GetCompartment(kGlobalNativeOpen, &compartment);
+  if (FAILED(result) || !_CurrentActivation(activation))
+    return FAILED(result) ? result : E_UNEXPECTED;
+  CComVariant initial;
+  result = compartment->GetValue(&initial);
+  if (FAILED(result) || !_CurrentActivation(activation))
+    return FAILED(result) ? result : E_UNEXPECTED;
+  if (initial.vt == VT_EMPTY) {
+    CComVariant open(static_cast<LONG>(TRUE));
+    result = compartment->SetValue(activation->client, &open);
+    if (FAILED(result) || !_CurrentActivation(activation))
+      return FAILED(result) ? result : E_UNEXPECTED;
+  } else if (initial.vt != VT_I4) return E_UNEXPECTED;
+
+  const std::weak_ptr<ActivationBindings> weak = activation;
+  com_ptr<CCompartmentEventSink> sink;
+  sink.Attach(new CCompartmentEventSink([this, weak](REFGUID) {
+    const auto owner = weak.lock();
+    if (owner && _CurrentActivation(owner) && owner->nativeWindow)
+      PostMessageW(owner->nativeWindow, kApplyGlobalNativeOpen, 0, 0);
+    return S_OK; // SetValue remains outside the compartment notification.
+  }));
+  result = sink->_Advise(static_cast<IUnknown*>(manager.p), kGlobalNativeOpen);
+  if (result != S_OK || !_CurrentActivation(activation)) {
+    activation->RecordCleanup(sink->_Unadvise());
+    return FAILED(result) ? result : E_UNEXPECTED;
+  }
+  activation->globalCompartment.Attach(compartment.Detach());
+  activation->globalSink.Attach(sink.Detach());
+  activation->globalOpenEnabled = true;
+  return S_OK;
+}
+
+void WeaselTSF::_UninitGlobalKeyboardOpen(ActivationBindings& activation) {
+  activation.globalOpenEnabled = false;
+  const HWND window = activation.nativeWindow;
+  activation.nativeWindow = nullptr;
+  com_ptr<CCompartmentEventSink> sink;
+  com_ptr<ITfCompartment> compartment;
+  sink.Attach(activation.globalSink.Detach());
+  compartment.Attach(activation.globalCompartment.Detach());
+  if (sink) activation.RecordCleanup(sink->_Unadvise());
+  if (window && IsWindow(window) && !DestroyWindow(window)) {
+    const DWORD error = GetLastError();
+    activation.RecordCleanup(error ? HRESULT_FROM_WIN32(error) : E_FAIL);
+    // Its window-owned token remains valid and rejects the retired weak cell.
+    // No custom class or raw activation pointer can dangle after this failure.
+  }
+}
+
+void WeaselTSF::_QueueGlobalKeyboardOpen() {
+  const auto activation = _activation;
+  if (activation && activation->nativeWindow)
+    PostMessageW(activation->nativeWindow, kApplyGlobalNativeOpen, 0, 0);
+}
+
+HRESULT WeaselTSF::_ReadGlobalKeyboardOpen(BOOL& open) {
+  const auto activation = _activation;
+  if (!activation || !activation->globalCompartment) return E_UNEXPECTED;
+  const com_ptr<ITfCompartment> compartment = activation->globalCompartment;
+  CComVariant value;
+  const HRESULT result = compartment->GetValue(&value);
+  if (!_CurrentActivation(activation)) return E_UNEXPECTED;
+  if (FAILED(result)) return result;
+  if (value.vt != VT_I4) return E_UNEXPECTED;
+  open = value.lVal != 0;
+  return S_OK;
+}
+
+HRESULT WeaselTSF::_ToggleGlobalKeyboardOpen() {
+  const auto activation = _activation;
+  BOOL open;
+  HRESULT result = _ReadGlobalKeyboardOpen(open);
+  if (FAILED(result) || !_CurrentActivation(activation))
+    return FAILED(result) ? result : E_UNEXPECTED;
+  const com_ptr<ITfCompartment> compartment = activation->globalCompartment;
+  if (!_CurrentActivation(activation)) return E_UNEXPECTED;
+  CComVariant value(static_cast<LONG>(!open));
+  result = compartment->SetValue(activation->client, &value);
+  if (SUCCEEDED(result) && _CurrentActivation(activation)) _ApplyGlobalKeyboardOpen();
+  return result;
+}
+
+void WeaselTSF::_ApplyGlobalKeyboardOpen() {
+  const auto activation = _activation;
+  if (!activation || !activation->globalOpenEnabled) return;
+  BOOL open;
+  if (FAILED(_ReadGlobalKeyboardOpen(open)) || !_CurrentActivation(activation)) return;
+  const BOOL currentOpen = _IsKeyboardOpen();
+  if (!_CurrentActivation(activation)) return;
+  if (currentOpen != open) {
+    const HRESULT result = _SetKeyboardOpen(open);
+    if (FAILED(result) || !_CurrentActivation(activation)) return;
+  }
+  _EnableLanguageBar(open);
+  if (!_CurrentActivation(activation)) return;
+  const com_ptr<CLangBarItemButton> button = activation->languageButton;
+  if (button) button->UpdateWeaselStatus(_status);
+}
+
+STDAPI CCompartmentEventSink::QueryInterface(REFIID riid,
+                                             _Outptr_ void** ppvObj) {
+  if (ppvObj == nullptr)
+    return E_INVALIDARG;
+
+  *ppvObj = nullptr;
+
+  if (IsEqualIID(riid, IID_IUnknown) ||
+      IsEqualIID(riid, IID_ITfCompartmentEventSink)) {
+    *ppvObj = (CCompartmentEventSink*)this;
+  }
+
+  if (*ppvObj) {
+    AddRef();
+    return S_OK;
+  }
+
+  return E_NOINTERFACE;
+}
+
+STDAPI_(ULONG) CCompartmentEventSink::AddRef() {
+  return ++_refCount;
+}
+
+STDAPI_(ULONG) CCompartmentEventSink::Release() {
+  LONG cr = --_refCount;
+
+  assert(_refCount >= 0);
+
+  if (_refCount == 0) {
+    delete this;
+  }
+
+  return cr;
+}
+
+STDAPI CCompartmentEventSink::OnChange(_In_ REFGUID guidCompartment) {
+  const com_ptr<CCompartmentEventSink> keepAlive(this);
+  return _callback(guidCompartment);
+}
+
+HRESULT CCompartmentEventSink::_Advise(_In_ com_ptr<IUnknown> owner,
+                                        _In_ REFGUID guid) {
+  const com_ptr<CCompartmentEventSink> keepAlive(this);
+  com_ptr<ITfCompartmentMgr> manager;
+  HRESULT result = owner->QueryInterface(&manager);
+  if (FAILED(result)) return result;
+  com_ptr<ITfCompartment> compartment;
+  result = manager->GetCompartment(guid, &compartment);
+  if (FAILED(result)) return result;
+  com_ptr<ITfSource> source;
+  result = compartment->QueryInterface(&source);
+  if (FAILED(result)) return result;
+  DWORD cookie = TF_INVALID_COOKIE;
+  result = source->AdviseSink(IID_ITfCompartmentEventSink, this, &cookie);
+  if (result == S_OK) {
+    _source.Attach(source.Detach());
+    _cookie = cookie;
+  }
+  return result;
+}
+HRESULT CCompartmentEventSink::_Unadvise() {
+  const com_ptr<CCompartmentEventSink> keepAlive(this);
+  const DWORD cookie = _cookie;
+  _cookie = TF_INVALID_COOKIE;
+  com_ptr<ITfSource> source;
+  source.Attach(_source.Detach());
+  return source && cookie != TF_INVALID_COOKIE ? source->UnadviseSink(cookie) : S_OK;
+}
+
+BOOL WeaselTSF::_IsKeyboardDisabled(ITfContext* targetContext) {
+  ITfCompartmentMgr* pCompMgr = NULL;
+  ITfDocumentMgr* pDocMgrFocus = NULL;
+  ITfContext* pContext = targetContext;
+  const auto activation = _activation;
+  const com_ptr<ITfThreadMgr> thread = activation ? activation->thread : nullptr;
+  BOOL fDisabled = FALSE;
+  if (!pContext && !activation) return TRUE;
+
+  if (pContext) {
+    // A key callback identifies its recipient even while host focus changes.
+    pContext->AddRef();
+  } else {
+    // Non-key callers retain the current-focus lookup.
+    if ((thread->GetFocus(&pDocMgrFocus) != S_OK) ||
+        (pDocMgrFocus == NULL)) {
+      fDisabled = TRUE;
+      goto Exit;
+    }
+
+    if ((pDocMgrFocus->GetTop(&pContext) != S_OK) || (pContext == NULL)) {
+      fDisabled = TRUE;
+      goto Exit;
+    }
+  }
+
+  if (pContext->QueryInterface(IID_ITfCompartmentMgr, (void**)&pCompMgr) ==
+      S_OK) {
+    ITfCompartment* pCompartmentDisabled;
+    ITfCompartment* pCompartmentEmptyContext;
+
+    /* Check GUID_COMPARTMENT_KEYBOARD_DISABLED */
+    if (pCompMgr->GetCompartment(GUID_COMPARTMENT_KEYBOARD_DISABLED,
+                                 &pCompartmentDisabled) == S_OK) {
+      VARIANT var;
+      if (pCompartmentDisabled->GetValue(&var) == S_OK) {
+        if (var.vt == VT_I4)  // Even VT_EMPTY, GetValue() can succeed
+          fDisabled = fDisabled || (var.lVal != 0);
+      }
+      pCompartmentDisabled->Release();
+    }
+
+    /* Check GUID_COMPARTMENT_EMPTYCONTEXT */
+    if (pCompMgr->GetCompartment(GUID_COMPARTMENT_EMPTYCONTEXT,
+                                 &pCompartmentEmptyContext) == S_OK) {
+      VARIANT var;
+      if (pCompartmentEmptyContext->GetValue(&var) == S_OK) {
+        if (var.vt == VT_I4)  // Even VT_EMPTY, GetValue() can succeed
+          fDisabled = fDisabled || (var.lVal != 0);
+      }
+      pCompartmentEmptyContext->Release();
+    }
+    pCompMgr->Release();
+  }
+
+Exit:
+  if (pContext)
+    pContext->Release();
+  if (pDocMgrFocus)
+    pDocMgrFocus->Release();
+  return fDisabled;
+}
+
+BOOL WeaselTSF::_IsKeyboardOpen() {
+  const auto activation = _activation;
+  if (!activation) return FALSE;
+  const com_ptr<ITfThreadMgr> thread = activation->thread;
+  if (!_CurrentActivation(activation)) return FALSE;
+  com_ptr<ITfCompartmentMgr> manager;
+  if (thread->QueryInterface(&manager) != S_OK) return FALSE;
+  com_ptr<ITfCompartment> compartment;
+  if (manager->GetCompartment(GUID_COMPARTMENT_KEYBOARD_OPENCLOSE, &compartment) != S_OK)
+    return FALSE;
+  CComVariant value;
+  return compartment->GetValue(&value) == S_OK && value.vt == VT_I4 ?
+      static_cast<BOOL>(value.lVal) : FALSE;
+}
+
+HRESULT WeaselTSF::_SetKeyboardOpen(BOOL open) {
+  return _SetCompartmentDWORD(static_cast<DWORD>(open), GUID_COMPARTMENT_KEYBOARD_OPENCLOSE);
+}
+
+HRESULT WeaselTSF::_GetCompartmentDWORD(DWORD& value, const GUID guid) {
+  const auto activation = _activation;
+  if (!activation) return E_UNEXPECTED;
+  const com_ptr<ITfThreadMgr> thread = activation->thread;
+  if (!_CurrentActivation(activation)) return E_UNEXPECTED;
+  com_ptr<ITfCompartmentMgr> manager;
+  HRESULT result = thread->QueryInterface(&manager);
+  if (FAILED(result)) return result;
+  com_ptr<ITfCompartment> compartment;
+  result = manager->GetCompartment(guid, &compartment);
+  if (FAILED(result)) return result;
+  CComVariant observed;
+  result = compartment->GetValue(&observed);
+  if (!_CurrentActivation(activation)) return E_UNEXPECTED;
+  if (FAILED(result)) return result;
+  if (observed.vt != VT_I4) return S_FALSE;
+  value = static_cast<DWORD>(observed.lVal);
+  return S_OK;
+}
+
+HRESULT WeaselTSF::_SetCompartmentDWORD(const DWORD& value, const GUID guid) {
+  const auto activation = _activation;
+  if (!activation) return E_UNEXPECTED;
+  const com_ptr<ITfThreadMgr> thread = activation->thread;
+  if (!_CurrentActivation(activation)) return E_UNEXPECTED;
+  com_ptr<ITfCompartmentMgr> manager;
+  HRESULT result = thread->QueryInterface(&manager);
+  if (FAILED(result) || !_CurrentActivation(activation))
+    return FAILED(result) ? result : E_UNEXPECTED;
+  com_ptr<ITfCompartment> compartment;
+  result = manager->GetCompartment(guid, &compartment);
+  if (FAILED(result) || !_CurrentActivation(activation))
+    return FAILED(result) ? result : E_UNEXPECTED;
+  CComVariant observed(static_cast<LONG>(value));
+  return compartment->SetValue(activation->client, &observed);
+}
+
+BOOL WeaselTSF::_InitCompartment(const Activation& activation) {
+  if (!_CurrentActivation(activation)) return FALSE;
+  const com_ptr<ITfThreadMgr> thread = activation->thread;
+  if (!_CurrentActivation(activation)) return FALSE;
+  const std::weak_ptr<ActivationBindings> weak = activation;
+  const auto callback = [this, weak](REFGUID guid) {
+    const auto owner = weak.lock();
+    return owner && _CurrentActivation(owner) ? _HandleCompartment(owner, guid) : S_OK;
+  };
+  com_ptr<CCompartmentEventSink> keyboard;
+  keyboard.Attach(new CCompartmentEventSink(callback));
+  HRESULT result = keyboard->_Advise(static_cast<IUnknown*>(thread.p),
+      GUID_COMPARTMENT_KEYBOARD_OPENCLOSE);
+  if (result != S_OK || !_CurrentActivation(activation)) {
+    activation->RecordCleanup(keyboard->_Unadvise());
+    return FALSE;
+  }
+  activation->keyboardSink.Attach(keyboard.Detach());
+  com_ptr<CCompartmentEventSink> conversion;
+  conversion.Attach(new CCompartmentEventSink(callback));
+  result = conversion->_Advise(static_cast<IUnknown*>(thread.p),
+      GUID_COMPARTMENT_KEYBOARD_INPUTMODE_CONVERSION);
+  if (result != S_OK || !_CurrentActivation(activation)) {
+    activation->RecordCleanup(conversion->_Unadvise());
+    return FALSE;
+  }
+  activation->conversionSink.Attach(conversion.Detach());
+  return TRUE;
+}
+
+void WeaselTSF::_UninitCompartment(ActivationBindings& activation) {
+  com_ptr<CCompartmentEventSink> keyboard, conversion;
+  keyboard.Attach(activation.keyboardSink.Detach());
+  conversion.Attach(activation.conversionSink.Detach());
+  if (keyboard) activation.RecordCleanup(keyboard->_Unadvise());
+  if (conversion) activation.RecordCleanup(conversion->_Unadvise());
+}
+
+HRESULT WeaselTSF::_HandleCompartment(const Activation& activation, REFGUID guid) {
+  if (!_CurrentActivation(activation)) return S_OK;
+  if (IsEqualGUID(guid, GUID_COMPARTMENT_KEYBOARD_OPENCLOSE)) {
+    const BOOL open = _IsKeyboardOpen();
+    if (!_CurrentActivation(activation)) return S_OK;
+    if (!open) {
+      _AbortComposition(true);
+      if (!_CurrentActivation(activation)) return S_OK;
+      _status.composing = false;
+    }
+    _EnableLanguageBar(open);
+    if (!_CurrentActivation(activation)) return S_OK;
+    const com_ptr<CLangBarItemButton> button = activation->languageButton;
+    if (button) button->UpdateWeaselStatus(_status);
+  } else if (IsEqualGUID(guid, GUID_COMPARTMENT_KEYBOARD_INPUTMODE_CONVERSION)) {
+    const BOOL open = _IsKeyboardOpen();
+    if (!_CurrentActivation(activation)) return S_OK;
+    const com_ptr<CLangBarItemButton> button = activation->languageButton;
+    if (open && button) button->UpdateWeaselStatus(_status);
+  }
+  return S_OK;
+}
