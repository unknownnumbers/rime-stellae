+    std::unique_ptr<Entry> Prepare(IUnknown* owner, WPARAM key, LPARAM info) {
+      if (!owner) return nullptr;
+      auto next = std::make_unique<Entry>();
+      // Acquire the COM reference before IPC; publication must not call the host.
+      next->owner = owner;
+      next->virtualKey = key;
+      next->physicalKey = info & 0x01ff0000;
+      return next;
+    }
+    void Remember(std::unique_ptr<Entry>& next, const TestedKeyPublication* scope) {
+      if (!next) return;
+      const auto index = Find(next->owner, next->virtualKey, next->physicalKey, true);
+      if (index == entries.size()) {
+        next->activeTest = scope;
+        entries.push_back(std::move(next));
+      } else if (!entries[index]->activeTest) {
+        entries[index]->activeTest = scope;
+      }
+      // An opposite-seen old credit cannot deduplicate a new physical stroke.
+      // Keep any unused COM ref in the publication until its stack is stable.
+    }
+    void Finish(const TestedKeyPublication* scope) {
+      // Nested Actual may already have deleted the entry. Never retain an
+      // Entry pointer across COM; the live publication address is the token.
+      for (const auto& entry : entries)
