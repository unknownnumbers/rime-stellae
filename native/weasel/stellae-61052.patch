+STDAPI WeaselTSF::OnPreservedKey(ITfContext* pContext,
+                                 REFGUID rguid,
+                                 BOOL* pfEaten) {
+  *pfEaten = FALSE;
+  const auto activation = _activation;
+  if (activation && activation->globalOpenEnabled &&
+      IsEqualGUID(rguid, activation->preservedCommand) && !_IsKeyboardDisabled() &&
+      _CurrentActivation(activation)) {
+    *pfEaten = SUCCEEDED(_ToggleGlobalKeyboardOpen());
+  }
+  return S_OK;
+}
+
+BOOL WeaselTSF::_InitKeyEventSink(const Activation& activation) {
+  if (!_CurrentActivation(activation)) return FALSE;
+  const com_ptr<ITfKeyEventSink> sink = activation->keySink;
+  const com_ptr<ITfThreadMgr> thread = activation->thread;
+  if (!_CurrentActivation(activation)) return FALSE;
+  com_ptr<ITfKeystrokeMgr> manager;
+  HRESULT result = thread->QueryInterface(&manager);
+  if (result != S_OK || !_CurrentActivation(activation)) return FALSE;
+  result = manager->AdviseKeyEventSink(activation->client, sink, TRUE);
+  if (result != S_OK || !_CurrentActivation(activation)) {
+    // Only this successful installation acquired an unadvise obligation.
+    if (result == S_OK)
+      activation->RecordCleanup(manager->UnadviseKeyEventSink(activation->client));
+    return FALSE;
+  }
+  activation->keyManager.Attach(manager.Detach());
+  activation->keyAdvised = true;
+  return TRUE;
+}
+
+void WeaselTSF::_UninitKeyEventSink(ActivationBindings& activation) {
+  const bool advised = activation.keyAdvised, preserved = activation.preservedKey;
+  activation.keyAdvised = activation.preservedKey = false;
+  com_ptr<ITfKeystrokeMgr> manager;
+  manager.Attach(activation.keyManager.Detach());
+  if (!manager) return;
+  if (preserved) activation.RecordCleanup(manager->UnpreserveKey(activation.preservedCommand, &kNativeOpenKey));
+  if (advised) activation.RecordCleanup(manager->UnadviseKeyEventSink(activation.client));
+  // A retained old proxy keeps only its own key state for late Actual ACKs.
+  // It cannot process a fresh key after this activation has been retired.
+}
+
+BOOL WeaselTSF::_InitPreservedKey(const Activation& activation) {
+  if (!_CurrentActivation(activation) || !activation->keyManager) return FALSE;
+  // UnpreserveKey has no client/cookie parameter. Give this resource its own
+  // command identity, while keeping the existing physical Ctrl+Space command.
+  GUID command;
+  if (FAILED(CoCreateGuid(&command))) return FALSE;
+  const com_ptr<ITfKeystrokeMgr> manager = activation->keyManager;
+  if (!_CurrentActivation(activation)) return FALSE;
+  const HRESULT result = manager->PreserveKey(activation->client, command,
+      &kNativeOpenKey, L"", 0);
+  if (result != S_OK || !_CurrentActivation(activation)) {
+    if (result == S_OK)
+      activation->RecordCleanup(manager->UnpreserveKey(command, &kNativeOpenKey));
+    return FALSE;
+  }
+  activation->preservedCommand = command;
+  activation->preservedKey = true;
+  return TRUE;
+}
+
+void WeaselTSF::_UninitPreservedKey(ActivationBindings& activation) {
+  const bool registered = activation.preservedKey;
+  activation.preservedKey = false;
+  const com_ptr<ITfKeystrokeMgr> manager = activation.keyManager;
+  if (registered && manager)
+    activation.RecordCleanup(manager->UnpreserveKey(activation.preservedCommand, &kNativeOpenKey));
+}
