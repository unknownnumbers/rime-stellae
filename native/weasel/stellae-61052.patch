+bool WeaselTSF::_GetRootDir(std::wstring& dir) {
+  dir.clear();
+  // The Win32 installer writes this value in the 32-bit registry view.
+  // A missing installation must not terminate the application hosting TSF.
+  WCHAR value[MAX_PATH] = {};
+  DWORD bytes = sizeof(value);
+  HKEY key = NULL;
+  if (RegOpenKeyExW(HKEY_LOCAL_MACHINE, STELLAE_REG_KEY, 0,
+                    KEY_QUERY_VALUE | KEY_WOW64_32KEY, &key) != ERROR_SUCCESS)
+    return false;
+  const LSTATUS status = RegGetValueW(
+      key, NULL, L"WeaselRoot", RRF_RT_REG_SZ, NULL, value, &bytes);
+  RegCloseKey(key);
+  if (status != ERROR_SUCCESS || value[0] == L'\0')
+    return false;
+  dir.assign(value);
+  return true;
 }
 
