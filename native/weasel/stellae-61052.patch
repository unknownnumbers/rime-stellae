+bool WeaselTSF::_Reconnect() {
+  const com_ptr<CCandidateList> candidate = _cand;
+  if (!candidate) return false;
+  // Retire local eligibility before replacing the engine session. Keep these
+  // references until the new connection state is coherent and old owned work
+  // has been submitted; releasing a native resource may call the host.
+  const auto previousDraft = std::move(_responseIntent);
+  const auto previousCandidate = candidate->RegisteredIntent();
+  const auto previousResponse = std::move(_lastResponse);
+  const auto previousProducer = std::move(_producerResponse);
+  com_ptr<ITfComposition> previousMirror;
+  previousMirror.Attach(_pComposition.Detach());
+  _engineResponseIntent.reset();
+  if (previousDraft) {
+    previousDraft->valid = false;
+    previousDraft->cancelled = true;
+  }
+  _status.composing = false;
+  _committed = FALSE;
+
+  // All Client access remains on the owning TSF thread. These pipe operations
+  // and value parsing make no host COM/UI call. In particular, do not clear
+  // the new engine through the previous draft's old engine-owner token.
+  m_client.Disconnect();
+  bool active = false;
+  bool parsed = false;
+  weasel::Status status;
+  auto style = candidate->style();
+  if (m_client.Connect(NULL)) {
+    m_client.StartSession();
+    // Echo has no body and invalidates the receive buffer. Copy the actual
+    // StartSession response first, then verify the nonzero session by Echo.
+    weasel::ResponseParser parser(NULL, NULL, &status, NULL, &style);
+    parsed = m_client.ResponseGeneration() != 0 &&
+        m_client.GetResponseData(std::ref(parser));
+    active = m_client.Echo();
+  }
+  if (active && parsed) {
+    _status = status;
+    _status.composing = false;
+    candidate->style() = style;
+  }
+
+  // Capture-time selected packets retain their own immutable text/range and
+  // still deliver. Cancelling only the current draft neither invalidates that
+  // registry nor submits a parallel End ahead of its selected predecessor.
+  if (previousDraft) _AbortComposition(true, previousDraft);
+  candidate->CancelUI(previousCandidate);
+  if (previousDraft != previousCandidate) candidate->CancelUI(previousDraft);
+  if (_cand == candidate && !_lastResponse) _UpdateLanguageBar(_status);
+
+  // Host callbacks above may have reconnected or processed another packet.
+  // Return the actual current session state, never the pre-callback result.
+  return _cand == candidate && m_client.Echo();
+}
+
+bool WeaselTSF::_EnsureServerConnected() {
+  if (m_client.Echo() || _Reconnect()) {
+    _serverConnectFailures = 0;
+    return true;
+  }
+  if (++_serverConnectFailures >= 6) {
+    // Preserve the existing finite launch policy, per service rather than a
+    // process-global counter shared by unrelated TSF threads.
+    _serverConnectFailures = 0;
+    HANDLE mutex = CreateMutexW(NULL, TRUE, STELLAE_DEPLOYER_EXCLUSIVE_MUTEX);
+    const DWORD mutexStatus = GetLastError();
+    if (mutex && mutexStatus != ERROR_ALREADY_EXISTS) {
+      std::wstring dir;
+      if (_GetRootDir(dir)) {
+        // ShellExecute launches asynchronously. There is no worker retaining
+        // this object or executing DLL code after this service can be released.
+        ShellExecuteW(NULL, L"open", (dir + L"\\start_service.bat").c_str(),
+            NULL, dir.c_str(), SW_HIDE);
+      }
+    }
+    if (mutex) CloseHandle(mutex);
+  }
+  // A later Ensure on this TSF thread reconnects after the service has started.
+  return false;
+}
