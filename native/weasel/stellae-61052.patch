+  auto& cinfo = _ui->ctx().cinfo;
+  if (uIndex >= cinfo.candies.size())
+    return E_INVALIDARG;
+
+  auto& str = cinfo.candies[uIndex].str;
+  *pbstr = SysAllocStringLen(str.c_str(), static_cast<UINT>(str.size()));
+
+  return S_OK;
+}
