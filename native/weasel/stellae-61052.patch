+STDAPI WeaselTSF::OnInitDocumentMgr(ITfDocumentMgr* pDocMgr) {
+  return S_OK;
+}
+
+STDAPI WeaselTSF::OnUninitDocumentMgr(ITfDocumentMgr* document) {
+  const Activation activation = _activation;
+  const auto target = _responseIntent;
+  com_ptr<ITfContext> source = target ? target->owner : _pEditSessionContext;
+  if (!_CurrentActivation(activation)) return S_OK;
+  com_ptr<ITfDocumentMgr> owner;
+  if (source && SUCCEEDED(source->GetDocumentMgr(&owner))) {
+    if (!_CurrentActivation(activation)) return S_OK;
+    const bool same = response_owner::SameIdentity(owner, document);
+    if (_CurrentActivation(activation) && same) _AbortComposition(true, target);
+  }
+  return S_OK;
+}
+
+STDAPI WeaselTSF::OnSetFocus(ITfDocumentMgr* focused, ITfDocumentMgr*) {
+  const Activation activation = _activation;
+  const com_ptr<CCandidateList> candidate = _cand;
+  if (!candidate || !activation) return S_OK;
+  const auto target = _responseIntent;
+  com_ptr<ITfContext> source = target ? target->owner : _pEditSessionContext;
+  if (!_CurrentActivation(activation)) return S_OK;
+  _PromptTrace(prompt_trace::DocumentFocus, _pEditSessionContext, _pComposition,
+      focused ? prompt_trace::OperationTrue : 0);
+  std::shared_ptr<TextEditBinding> binding;
+  _InitTextEditSink(focused, &binding);
+  const auto current = [this, activation, candidate, binding]() {
+    return _CurrentActivation(activation) && _cand == candidate &&
+        _textEditBinding == binding;
+  };
+  if (!current()) return S_OK;
+  if (source) {
+    // GetTop already populated this request's cell. Never query a second top
+    // after a nested focus has had a chance to replace the active document.
+    const bool same = response_owner::SameIdentity(binding->context, source);
+    if (!current()) return S_OK;
+    if (!same) _AbortComposition(true, target);
+    if (!current()) return S_OK;
+  }
+  if (focused) _ApplyGlobalKeyboardOpen();
+  if (!current()) return S_OK;
+  candidate->UpdateDocumentFocus(focused);
+  return S_OK;
+}
+
+STDAPI WeaselTSF::OnPushContext(ITfContext* context) {
+  const Activation activation = _activation;
+  const com_ptr<CCandidateList> candidate = _cand;
+  const auto target = _responseIntent;
+  com_ptr<ITfContext> source = target ? target->owner : _pEditSessionContext;
+  const auto current = [&]() {
+    return _CurrentActivation(activation) && _cand == candidate;
+  };
+  if (!current()) return S_OK;
+  _PromptTrace(prompt_trace::ContextPush, context, _pComposition);
+  if (source) {
+    const bool same = response_owner::SameIdentity(source, context);
+    if (!current()) return S_OK;
+    if (!same) {
+      com_ptr<ITfDocumentMgr> oldDocument, newDocument;
+      const HRESULT oldResult = source->GetDocumentMgr(&oldDocument);
+      if (!current()) return S_OK;
+      if (SUCCEEDED(oldResult)) {
+        const HRESULT newResult = context->GetDocumentMgr(&newDocument);
+        if (!current()) return S_OK;
+        const bool sameDocument = SUCCEEDED(newResult) &&
+            response_owner::SameIdentity(oldDocument, newDocument);
+        if (!current()) return S_OK;
+        if (sameDocument) _AbortComposition(true, target);
+      }
+    }
+  }
+  if (current()) _RefreshContextBinding(context, false);
+  return S_OK;
+}
+
+STDAPI WeaselTSF::OnPopContext(ITfContext* context) {
+  const Activation activation = _activation;
+  const com_ptr<CCandidateList> candidate = _cand;
+  const auto target = _responseIntent;
+  com_ptr<ITfContext> source = target ? target->owner : _pEditSessionContext;
+  const auto current = [&]() {
+    return _CurrentActivation(activation) && _cand == candidate;
+  };
+  if (!current()) return S_OK;
+  _PromptTrace(prompt_trace::ContextPop, context, _pComposition);
+  const bool same = source && response_owner::SameIdentity(source, context);
+  if (!current()) return S_OK;
+  if (same) _AbortComposition(true, target);
+  if (current()) _RefreshContextBinding(context, true);
+  return S_OK;
+}
+
+void WeaselTSF::_RefreshContextBinding(ITfContext* context, bool popped) {
+  const Activation activation = _activation;
+  const com_ptr<CCandidateList> candidate = _cand;
+  const auto previous = _textEditBinding;
+  const com_ptr<ITfThreadMgr> thread = activation ? activation->thread : nullptr;
+  const auto current = [this, activation, candidate, previous]() {
+    return _CurrentActivation(activation) && _cand == candidate &&
+        _textEditBinding == previous;
+  };
+  // A live binding may await GetTop, but an empty teardown/no-document cell
+  // must never restart subscriptions while Deactivate is releasing them.
+  if (!current() || !candidate || !thread || !context || !previous ||
+      previous->candidate != candidate) return;
+  com_ptr<ITfDocumentMgr> changedDocument;
+  if (popped) {
+    // A popped context has no DocumentMgr. A known different subscription
+    // belongs to another stack. An empty cell may still await GetTop's out
+    // parameter: refresh it so that late result cannot bind a removed top.
+    const bool different = previous->context &&
+        !response_owner::SameIdentity(previous->context, context);
+    if (!current() || different) return;
+  } else {
+    const HRESULT result = context->GetDocumentMgr(&changedDocument);
+    if (!current() || result != S_OK || !changedDocument) return;
+  }
+  com_ptr<ITfDocumentMgr> focused;
+  const HRESULT result = thread->GetFocus(&focused);
+  if (!current() || result != S_OK) return;
+  if (!popped) {
+    const bool relevant = response_owner::SameIdentity(changedDocument, focused);
+    if (!current() || !relevant) return;
+  }
+  std::shared_ptr<TextEditBinding> replacement;
+  _InitTextEditSink(focused, &replacement);
+  if (_CurrentActivation(activation) && _cand == candidate &&
+      _textEditBinding == replacement)
+    candidate->UpdateDocumentFocus(focused);
+}
+
+BOOL WeaselTSF::_InitThreadMgrEventSink(const Activation& activation) {
+  if (!_CurrentActivation(activation)) return FALSE;
+  const com_ptr<ITfThreadMgrEventSink> sink = activation->threadEventsSink;
+  const com_ptr<ITfThreadMgr> thread = activation->thread;
+  if (!_CurrentActivation(activation)) return FALSE;
+  com_ptr<ITfSource> source;
+  HRESULT result = thread->QueryInterface(&source);
+  if (result != S_OK || !_CurrentActivation(activation)) return FALSE;
+  DWORD cookie = TF_INVALID_COOKIE;
+  result = source->AdviseSink(IID_ITfThreadMgrEventSink, sink, &cookie);
+  if (result != S_OK || !_CurrentActivation(activation)) {
+    if (result == S_OK && cookie != TF_INVALID_COOKIE)
+      activation->RecordCleanup(source->UnadviseSink(cookie));
+    return FALSE;
+  }
+  activation->threadEvents.source.Attach(source.Detach());
+  activation->threadEvents.cookie = cookie;
+  return TRUE;
+}
+
+void WeaselTSF::_UninitThreadMgrEventSink(ActivationBindings& activation) {
+  activation.RecordCleanup(activation.threadEvents.Disconnect());
+}
