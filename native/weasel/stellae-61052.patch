+        auto& entry = entries[i];
+        if (entry->owner.p != owner || entry->virtualKey != key ||
+            entry->physicalKey != (info & 0x01ff0000)) { ++i; continue; }
+        if (entry->activeTest) {
+          // Its enclosing Test still owes the host a possible Actual call.
+          entry->oppositeSeen = true;
+          ++i;
+        } else {
+          retired.push_back(std::move(entry));
+          entries.erase(entries.begin() + i);
+        }
+      }
+      // Release retired identities only after the entire table is stable.
+    }
+    bool Take(IUnknown* owner, WPARAM key, LPARAM info) {
+      if (!owner) return false;
+      const auto index = Find(owner, key, info);
+      if (index == entries.size()) return false;
+      auto retired = std::move(entries[index]);
+      entries.erase(entries.begin() + index);
+      // Any final COM Release happens after the container is stable.
+      return true;
+    }
