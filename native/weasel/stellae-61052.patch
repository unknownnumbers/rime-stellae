-void WeaselTSF::_UninitPreservedKey() {}
+#include "stdafx.h"
+#include "WeaselIPC.h"
+#include "WeaselTSF.h"
+#include <KeyEvent.h>
+#include <ShiftKeySnapshotWin.h>
+#include "CandidateList.h"
+
+// Shared by the two injected Caps events, and representable on x86 and x64.
+static constexpr ULONG_PTR kStellaeCapsCompensationTag = 0x53544350UL;
+
+// Generic modifiers share a virtual key but have distinct physical sides.
+static size_t TestedKeySlot(WPARAM key, LPARAM info) {
+  if (key == VK_SHIFT)
+    return ((info >> 16) & 0xff) == 0x36 ? VK_RSHIFT : VK_LSHIFT;
+  if (key == VK_CONTROL)
+    return (info & 0x01000000) ? VK_RCONTROL : VK_LCONTROL;
+  if (key == VK_MENU)
+    return (info & 0x01000000) ? VK_RMENU : VK_LMENU;
+  return key < 256 ? static_cast<size_t>(key) : 0;
+}
+
+// Query COM identity before touching a key record. Matching and removing
+// pending callbacks then use only pointer/key comparisons, with no host calls.
+static com_ptr<IUnknown> KeyContextIdentity(ITfContext* context) {
+  com_ptr<IUnknown> identity;
+  if (context)
+    context->QueryInterface(IID_IUnknown, reinterpret_cast<void**>(&identity));
+  return identity;
+}
+
+// Keep native enable/disable separate from Rime's logical language switch.
+static const TF_PRESERVEDKEY kNativeOpenKey = {VK_SPACE, TF_MOD_CONTROL};
+
+// One registered callback object identifies one activation. A late callback
+// from a retired source cannot enter the next activation through service this.
+class CActivationEventSink final : public ITfThreadMgrEventSink,
+                                   public ITfThreadFocusSink,
+                                   public ITfKeyEventSink {
+ public:
+  CActivationEventSink(WeaselTSF* service, const WeaselTSF::Activation& activation)
+      : service_(service), activation_(activation), keys_(activation->keyState) {}
+  STDMETHODIMP QueryInterface(REFIID iid, void** value) override {
+    if (!value) return E_POINTER;
+    *value = nullptr;
+    if (iid == IID_IUnknown || iid == IID_ITfThreadMgrEventSink)
+      *value = static_cast<ITfThreadMgrEventSink*>(this);
+    else if (iid == IID_ITfThreadFocusSink)
+      *value = static_cast<ITfThreadFocusSink*>(this);
+    else if (iid == IID_ITfKeyEventSink)
+      *value = static_cast<ITfKeyEventSink*>(this);
+    if (!*value) return E_NOINTERFACE;
+    AddRef();
+    return S_OK;
+  }
+  STDMETHODIMP_(ULONG) AddRef() override { return ++references_; }
+  STDMETHODIMP_(ULONG) Release() override {
+    const ULONG left = --references_;
+    if (!left) delete this;
+    return left;
+  }
+  STDMETHODIMP OnInitDocumentMgr(ITfDocumentMgr* value) override {
+    return Dispatch([&]() { return service_->OnInitDocumentMgr(value); });
+  }
+  STDMETHODIMP OnUninitDocumentMgr(ITfDocumentMgr* value) override {
+    return Dispatch([&]() { return service_->OnUninitDocumentMgr(value); });
+  }
+  STDMETHODIMP OnSetFocus(ITfDocumentMgr* value, ITfDocumentMgr* previous) override {
+    return Dispatch([&]() { return service_->OnSetFocus(value, previous); });
+  }
+  STDMETHODIMP OnPushContext(ITfContext* value) override {
+    return Dispatch([&]() { return service_->OnPushContext(value); });
+  }
+  STDMETHODIMP OnPopContext(ITfContext* value) override {
+    return Dispatch([&]() { return service_->OnPopContext(value); });
+  }
+  STDMETHODIMP OnSetThreadFocus() override {
+    return Dispatch([&]() { return service_->OnSetThreadFocus(); });
+  }
+  STDMETHODIMP OnKillThreadFocus() override {
+    return Dispatch([&]() { return service_->OnKillThreadFocus(); });
+  }
+  STDMETHODIMP OnSetFocus(BOOL foreground) override {
+    return Dispatch([&]() { return service_->OnSetFocus(foreground); });
+  }
+  STDMETHODIMP OnTestKeyDown(ITfContext* context, WPARAM key, LPARAM info, BOOL* eaten) override {
+    return DispatchKey(context, key, info, true, false, eaten);
+  }
+  STDMETHODIMP OnKeyDown(ITfContext* context, WPARAM key, LPARAM info, BOOL* eaten) override {
+    return DispatchKey(context, key, info, false, false, eaten);
+  }
+  STDMETHODIMP OnTestKeyUp(ITfContext* context, WPARAM key, LPARAM info, BOOL* eaten) override {
+    return DispatchKey(context, key, info, true, true, eaten);
+  }
+  STDMETHODIMP OnKeyUp(ITfContext* context, WPARAM key, LPARAM info, BOOL* eaten) override {
+    return DispatchKey(context, key, info, false, true, eaten);
+  }
+  STDMETHODIMP OnPreservedKey(ITfContext* context, REFGUID key, BOOL* eaten) override {
+    if (!eaten) return E_POINTER;
+    *eaten = FALSE;
+    return Dispatch([&]() { return service_->OnPreservedKey(context, key, eaten); });
+  }
+ private:
+  HRESULT DispatchKey(ITfContext* context, WPARAM key, LPARAM info,
+      bool test, bool release, BOOL* eaten) {
+    com_ptr<CActivationEventSink> keepAlive(this);
+    // An old proxy may only acknowledge its already consumed key. It never
+    // enters the engine or native/UI delivery of a newer activation.
+    return service_->_HandleKeyCallback(activation_.lock(), keys_, context,
+        key, info, test, release, eaten);
+  }
+  template<class Action> HRESULT Dispatch(Action&& action) {
+    com_ptr<CActivationEventSink> keepAlive(this);
+    const auto activation = activation_.lock();
+    return service_->_CurrentActivation(activation) ? action() : S_OK;
+  }
+  ULONG references_ = 1;
+  com_ptr<WeaselTSF> service_;
+  std::weak_ptr<WeaselTSF::ActivationBindings> activation_;
+  std::shared_ptr<WeaselTSF::KeyCallbackState> keys_;
+};
+
+void WeaselTSF::_InitActivationCallbacks(const Activation& activation) {
+  com_ptr<CActivationEventSink> callbacks;
+  callbacks.Attach(new CActivationEventSink(this, activation));
+  activation->threadEventsSink = static_cast<ITfThreadMgrEventSink*>(callbacks.p);
+  activation->threadFocusSink = static_cast<ITfThreadFocusSink*>(callbacks.p);
+  activation->keySink = static_cast<ITfKeyEventSink*>(callbacks.p);
+}
+
+void WeaselTSF::_ProcessKeyEvent(ITfContext* pContext,
+                                 const com_ptr<CCandidateList>& candidate,
+                                 WPARAM wParam,
+                                 LPARAM lParam,
+                                 BOOL* pfEaten,
+                                 TestedKeyPublication* publication) {
+  *pfEaten = FALSE;
+  const auto activation = _activation;
+  const auto current = [&]() {
+    return _CurrentActivation(activation) && candidate && _cand == candidate;
+  };
+  if (!current()) return;
+  auto& keys = *activation->keyState;
+  const DWORD shiftMessageTime = (wParam == VK_SHIFT || wParam == VK_LSHIFT ||
+      wParam == VK_RSHIFT) ? static_cast<DWORD>(GetMessageTime()) : 0;
+  _PromptTrace(prompt_trace::KeyEnter, pContext);
+  // when _IsKeyboardDisabled don't eat the key,
+  // when keyboard closable and keyboard closed, don't eat the key
+  const bool open = !_isToOpenClose || _IsKeyboardOpen();
+  if (!current()) return;
+  if (!open) {
+    _PromptTrace(prompt_trace::KeyBypass, pContext, nullptr, prompt_trace::BypassClosed);
+    *pfEaten = FALSE;
+    return;
+  }
+  const bool disabled = _IsKeyboardDisabled(pContext);
+  if (!current()) return;
+  if (disabled) {
+    _PromptTrace(prompt_trace::KeyBypass, pContext, nullptr, prompt_trace::BypassDisabled);
+    *pfEaten = FALSE;
+    return;
+  }
+
+  // if server connection is Not OK, don't eat it.
+  const bool connected = _EnsureServerConnected();
+  if (!current()) return;
+  if (!connected) {
+    _PromptTrace(prompt_trace::KeyBypass, pContext, nullptr, prompt_trace::BypassServer);
+    *pfEaten = FALSE;
+    return;
+  }
+  weasel::KeyEvent ke;
+  BYTE keyState[256];
+  const BOOL keyboardStateValid = GetKeyboardState(keyState);
+  if (!keyboardStateValid) {
+    _PromptTrace(prompt_trace::KeyBypass, pContext, nullptr, prompt_trace::BypassConvert);
+    return; // Never convert using a previous callback's keyboard bitmap.
+  }
+  if (!ConvertKeyEvent(static_cast<UINT>(wParam), lParam, keyState, ke)) {
+    /* Unknown key event */
+    _PromptTrace(prompt_trace::KeyBypass, pContext, nullptr, prompt_trace::BypassConvert);
+    *pfEaten = FALSE;
+  } else {
+    if (ke.keycode == ibus::Shift_L || ke.keycode == ibus::Shift_R)
+      ke.shift_snapshot = weasel::CaptureShiftSnapshot(ke, KeyInfo(lParam),
+          keyboardStateValid, keyState, GetKeyboardLayout(0),
+          static_cast<UINT>(wParam), shiftMessageTime);
+    // cheet key code when vertical auto reverse happened, swap up and down
+    if (candidate->GetIsReposition()) {
+      if (ke.keycode == ibus::Up)
+        ke.keycode = ibus::Down;
+      else if (ke.keycode == ibus::Down)
+        ke.keycode = ibus::Up;
+    }
+    *pfEaten = (BOOL)_ProduceKeyResponse(pContext, ke, publication);
+    if (!current()) return; // Keep handled, but never inject a stale Caps tail into B.
+    const std::uint64_t kind = ke.keycode == ibus::space ? prompt_trace::SpaceSelection :
+        (ke.keycode >= '1' && ke.keycode <= '9') ? prompt_trace::DigitSelection :
+        ke.keycode == ibus::Return ? prompt_trace::ReturnKey : 0;
+    _PromptTrace(prompt_trace::KeyReturned, pContext, nullptr,
+        kind | ((ke.mask & ibus::RELEASE_MASK) ? prompt_trace::KeyRelease : 0) |
+        (*pfEaten ? prompt_trace::OperationTrue : 0));
+
+    if (ke.keycode == ibus::Caps_Lock) {
+      if (keys.previousWasCaps && keys.previousEaten == TRUE &&
+          (ke.mask & ibus::RELEASE_MASK)) {
+        const bool restoreCaps = (GetKeyState(VK_CAPITAL) & 0x01) &&
+            (_committed || (!*pfEaten && _HasCurrentPreedit()));
+        // Decide this compatibility consume before SendInput can deliver a
+        // nested callback. It is not an additional engine-handled result.
+        *pfEaten = TRUE;
+        if (publication && !publication->published) publication->Publish();
+        if (restoreCaps) {
+            INPUT inputs[2];
+            inputs[0].type = INPUT_KEYBOARD;
+            inputs[0].ki = {VK_CAPITAL, 0, 0, 0, kStellaeCapsCompensationTag};
+            inputs[1].type = INPUT_KEYBOARD;
+            inputs[1].ki = {VK_CAPITAL, 0, KEYEVENTF_KEYUP, 0, kStellaeCapsCompensationTag};
+            ::SendInput(sizeof(inputs) / sizeof(INPUT), inputs, sizeof(INPUT));
+            // Insertion count cannot identify a later callback. Only the
+            // event's marker bypasses Rime; no pending count survives here.
+        }
+      }
+    }
+
+    keys.previousEaten = *pfEaten;
+    keys.previousWasCaps = ke.keycode == ibus::Caps_Lock;
+  }
+}
+
+STDAPI WeaselTSF::OnSetFocus(BOOL fForeground) {
+  _PromptTrace(prompt_trace::KeyFocus, _pEditSessionContext, nullptr,
+      fForeground ? prompt_trace::OperationTrue : 0);
+  if (fForeground) {
+    const com_ptr<CCandidateList> candidate = _cand;
+    if (!candidate) return S_OK;
+    _ApplyGlobalKeyboardOpen();
+    if (_cand != candidate) return S_OK;
+    m_client.FocusIn();
+  } else {
+    m_client.FocusOut();
+    _AbortComposition();
+  }
+
+  return S_OK;
+}
+
+// Upstream asks the engine during Test, then acknowledges a matched Actual.
+// Keep those credits in their activation and publish before native/UI reentry.
+// Actual-only hosts still execute the same producer once.
+HRESULT WeaselTSF::_HandleKeyCallback(Activation activation,
+    std::shared_ptr<KeyCallbackState> keys, ITfContext* context,
+    WPARAM key, LPARAM info, bool test, bool release, BOOL* eaten) {
+  if (!eaten) return E_POINTER;
+  *eaten = FALSE;
+  // Read message metadata before any host COM call or Test/Actual lookup.
+  // A repeated callback for our injection must not take a physical key's credit.
+  if (key == VK_CAPITAL &&
+      static_cast<ULONG_PTR>(::GetMessageExtraInfo()) == kStellaeCapsCompensationTag)
+    return S_OK;
+  if (!keys) return S_OK;
+  const com_ptr<CCandidateList> candidate = _CurrentActivation(activation) ? _cand : nullptr;
+  const auto current = [&]() {
+    return _CurrentActivation(activation) && candidate && _cand == candidate;
+  };
+  if (test && !current()) return S_OK;
+  const com_ptr<IUnknown> owner = KeyContextIdentity(context);
+  const size_t slot = TestedKeySlot(key, info);
+  auto& records = release ? keys->testedUp[slot] : keys->testedDown[slot];
+  auto& opposite = release ? keys->testedDown[slot] : keys->testedUp[slot];
+  const std::uint64_t flags =
+      (test ? (release ? prompt_trace::TestUpCallback : prompt_trace::TestDownCallback) :
+          (release ? prompt_trace::ActualUpCallback : prompt_trace::ActualDownCallback)) |
+      (records.Present() ? prompt_trace::PendingPresent : 0);
+  if (current()) _PromptTrace(prompt_trace::CallbackEnter, context, nullptr, flags);
+  if (!test && records.Take(owner, key, info)) {
+    // Taking a credit may release a host identity; its result still belongs
+    // to this old key even if that Release retires the activation.
+    *eaten = TRUE;
+    if (current()) _PromptTrace(prompt_trace::CallbackReturned, context, nullptr,
+        flags | prompt_trace::PendingMatched | prompt_trace::OperationTrue);
+    return S_OK;
+  }
+  if (!current()) return S_OK;
+  if (test && records.Matches(owner, key, info)) {
+    *eaten = TRUE;
+    _PromptTrace(prompt_trace::CallbackReturned, context, nullptr,
+        flags | prompt_trace::PendingMatched | prompt_trace::OperationTrue);
+    return S_OK;
+  }
+  opposite.RetireOpposite(owner, key, info);
+  if (!current()) return S_OK;
+  if (test) {
+    TestedKeyPublication publication{records, records.Prepare(owner, key, info)};
+    if (!current()) return S_OK;
+    _ProcessKeyEvent(context, candidate, key, info, eaten, &publication);
+    // Caps compatibility can consume without a handled engine response.
+    // Do not recreate a credit already taken by a nested Actual callback.
+    if (*eaten && !publication.published) publication.Publish();
+  } else {
+    _ProcessKeyEvent(context, candidate, key, info, eaten);
+  }
+  if (current()) _PromptTrace(prompt_trace::CallbackReturned, context, nullptr,
+      flags | (*eaten ? prompt_trace::OperationTrue : 0));
+  return S_OK;
+}
+
+STDAPI WeaselTSF::OnTestKeyDown(ITfContext* context, WPARAM key, LPARAM info, BOOL* eaten) {
+  const auto activation = _activation;
+  return _HandleKeyCallback(activation, activation ? activation->keyState : nullptr,
+      context, key, info, true, false, eaten);
+}
