+STDAPI WeaselTSF::Deactivate() {
+  const com_ptr<WeaselTSF> keepAlive(this);
+  const auto activation = std::move(_activation);
+  if (!activation) return S_OK;
+  com_ptr<CCandidateList> candidate;
+  candidate.Attach(_cand.Detach());
+  const auto binding = std::move(_textEditBinding);
+  const auto intent = std::move(_responseIntent);
+  const auto producer = std::move(_producerResponse);
+  const auto last = std::move(_lastResponse);
+  const auto intents = std::move(_responseIntents);
+  _engineResponseIntent.reset();
+  com_ptr<ITfComposition> composition;
+  com_ptr<ITfContext> context;
+  composition.Attach(_pComposition.Detach());
+  context.Attach(_pEditSessionContext.Detach());
+  std::vector<response_owner::SelectionState*> revokedSelections;
+  const auto revoke = [&](const std::shared_ptr<response_owner::Intent>& old) {
+    if (!old) return;
+    old->valid = false;
+    old->cancelled = true;
+    if (old->selection && std::find(revokedSelections.begin(), revokedSelections.end(),
+        old->selection.get()) == revokedSelections.end()) {
+      old->selection->Revoke();
+      revokedSelections.push_back(old->selection.get());
+    }
+  };
+  for (const auto& old : intents) revoke(old);
+  revoke(intent);
+  _status.composing = false;
+  _committed = FALSE;
+  _deferredResponseFocus = false;
+  // All old COM references above were detached, not released. Finish the
+  // shared IPC session before any release/unadvise can activate B.
+  m_client.EndSession();
+  _PromptTrace(prompt_trace::Deactivate, context, composition);
+  if (binding) binding->Disconnect();
+  activation->Disconnect();
+  if (candidate) candidate->DestroyAll();
+  // Only local A references are released from here. New B globals are intact.
+  return activation->cleanupResult;
+}
+
+STDAPI WeaselTSF::ActivateEx(ITfThreadMgr* pThreadMgr,
+                             TfClientId tfClientId,
+                             DWORD dwFlags) {
+  const com_ptr<WeaselTSF> keepAlive(this);
+  if (!pThreadMgr || _activation) return E_UNEXPECTED;
+  auto activation = std::make_shared<ActivationBindings>();
+  activation->client = tfClientId;
+  activation->flags = dwFlags;
+  _activation = activation; // Reserve this identity before the first COM AddRef.
+  const auto fail = [this, activation]() {
+    if (_CurrentActivation(activation)) Deactivate();
+    else activation->Disconnect();
+    return E_FAIL;
+  };
+  activation->thread = pThreadMgr;
+  if (!_CurrentActivation(activation)) return fail();
+  const com_ptr<ITfThreadMgr> thread = activation->thread;
+  if (!_CurrentActivation(activation)) return fail();
+  _cand.Attach(new CCandidateList(this));
+  const com_ptr<CCandidateList> candidate = _cand;
+  _InitActivationCallbacks(activation);
+
+  if (!_InitThreadMgrEventSink(activation) || !_CurrentActivation(activation))
+    return fail();
+  com_ptr<ITfDocumentMgr> focused;
+  const HRESULT focusResult = thread->GetFocus(&focused);
+  if (!_CurrentActivation(activation)) return fail();
+  if (focusResult == S_OK && focused) _InitTextEditSink(focused);
+  if (!_CurrentActivation(activation)) return fail();
+  if (!_InitKeyEventSink(activation) || !_CurrentActivation(activation))
+    return fail();
+
+  _InitDisplayAttributeGuidAtom();
+  if (!_CurrentActivation(activation)) return fail();
+  if (!_InitLanguageBar(activation) || !_CurrentActivation(activation))
+    return fail();
+  if (!_InitCompartment(activation) || !_CurrentActivation(activation))
+    return fail();
+  if (!_InitThreadFocusSink(activation) || !_CurrentActivation(activation))
+    return fail();
+  _EnsureServerConnected();
+  if (!_CurrentActivation(activation)) return fail();
+
+  // The existing optional Ctrl+Space registration remains optional.
+  if (_InitPreservedKey(activation)) {
+    const HRESULT result = _InitGlobalKeyboardOpen(activation);
+    if (!_CurrentActivation(activation)) return fail();
+    if (FAILED(result)) {
+      _UninitGlobalKeyboardOpen(*activation);
+      _UninitPreservedKey(*activation);
+    }
+  }
+  if (!_CurrentActivation(activation)) return fail();
+  if (activation->globalOpenEnabled) _ApplyGlobalKeyboardOpen();
+  else if (!_IsKeyboardOpen()) {
+    if (!_CurrentActivation(activation)) return fail();
+    _SetKeyboardOpen(TRUE);
+  }
+  return _CurrentActivation(activation) && _cand == candidate ? S_OK : fail();
+}
+
+STDMETHODIMP WeaselTSF::OnSetThreadFocus() {
+  const com_ptr<CCandidateList> candidate = _cand;
+  if (!candidate) return S_OK;
+  _PromptTrace(prompt_trace::ThreadFocus, _pEditSessionContext, _pComposition);
+  _ApplyGlobalKeyboardOpen();
+  if (_cand != candidate) return S_OK;
+  // The fixed native-close policy must not depend on host HKCU visibility
+  // or whether a thread-focus notification preceded the close notification.
+  if (_producerResponse) {
+    _deferredResponseFocus = true;
+    return S_OK;
+  }
+  weasel::SessionMetadata metadata;
+  metadata.status = _status;
+  metadata.style = candidate->style();
+  if (m_client.QueryMetadata(metadata) && _cand == candidate) {
+    _status = metadata.status;
+    candidate->style() = std::move(metadata.style);
+    _UpdateLanguageBar(_status);
+  }
+  // This event has no content response body or content generation.
+  _PromptTrace(prompt_trace::ThreadFocusReturned, _pEditSessionContext,
+      _pComposition, 0, S_OK, -1, -1, -1, 0);
+  return S_OK;
+}
+STDMETHODIMP WeaselTSF::OnKillThreadFocus() {
+  _PromptTrace(prompt_trace::ThreadBlur, _pEditSessionContext, _pComposition);
+  _AbortComposition();
+  return S_OK;
+}
+BOOL WeaselTSF::_InitThreadFocusSink(const Activation& activation) {
+  if (!_CurrentActivation(activation)) return FALSE;
+  const com_ptr<ITfThreadFocusSink> sink = activation->threadFocusSink;
+  const com_ptr<ITfThreadMgr> thread = activation->thread;
+  if (!_CurrentActivation(activation)) return FALSE;
+  com_ptr<ITfSource> source;
+  HRESULT result = thread->QueryInterface(&source);
+  if (FAILED(result) || !_CurrentActivation(activation)) return FALSE;
+  DWORD cookie = TF_INVALID_COOKIE;
+  result = source->AdviseSink(IID_ITfThreadFocusSink, sink, &cookie);
+  if (result != S_OK || !_CurrentActivation(activation)) {
+    if (result == S_OK && cookie != TF_INVALID_COOKIE)
+      activation->RecordCleanup(source->UnadviseSink(cookie));
+    return FALSE;
+  }
+  activation->threadFocus.source.Attach(source.Detach());
+  activation->threadFocus.cookie = cookie;
+  return TRUE;
+}
+void WeaselTSF::_UninitThreadFocusSink(ActivationBindings& activation) {
+  activation.RecordCleanup(activation.threadFocus.Disconnect());
+}
+
+STDMETHODIMP WeaselTSF::OnActivated(REFCLSID clsid,
+                                    REFGUID guidProfile,
+                                    BOOL isActivated) {
+  if (!IsEqualCLSID(clsid, c_clsidTextService)) {
+    return S_OK;
+  }
+
+  if (isActivated) {
+    _ShowLanguageBar(TRUE);
+    _UpdateLanguageBar(_status);
+  } else {
+    _DeleteCandidateList();
+    _ShowLanguageBar(FALSE);
+  }
+  return S_OK;
+}
