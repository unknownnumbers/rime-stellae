+STDMETHODIMP CCandidateList::GetDocumentMgr(ITfDocumentMgr** ppdim) {
+  if (!ppdim) return E_POINTER;
+  *ppdim = nullptr;
+  // This registration belongs to its captured Context, not later focus.
+  const auto registered = _registeredIntent;
+  const com_ptr<ITfContext> owner = registered ? registered->owner : nullptr;
+  return owner ? owner->GetDocumentMgr(ppdim) : E_UNEXPECTED;
+}
