+/* Original-context document close */
+void WeaselTSF::_QueueEndDraft(
+    const std::shared_ptr<response_owner::Intent>& target, bool clear) {
+  using namespace response_owner;
+  if (!target) return;
+  const com_ptr<CCandidateList> candidate = _cand;
+  const bool wasCurrent = _responseIntent == target;
+  target->valid = false;
+  if (wasCurrent) _responseIntent.reset();
+  auto source = target;
+  std::shared_ptr<Packet> work = source->nativeWork.lock();
+  if (!source->composition && source->predecessor) {
+    // A captured selected P owns its write and native close. Cancellation of
+    // its successor must not submit a parallel End before P has written.
+    work = source->predecessor;
+    if (work->source) source = work->source;
+  }
+  // A successor's blur cannot authorize its selected predecessor to discover
+  // a later caret. Captured ranges/points and the commit itself remain owned.
+  if (target->cancelled && !source->range && !source->initialPoint)
+    source->initialSelection = false;
+  work = CleanupForAction(source, work, clear);
+  com_ptr<ITfComposition> retiredMirror;
+  if (source->composition && _IsCurrentComposition(source->composition)) {
+    _PromptTrace(prompt_trace::Finalized, source->owner, source->composition);
+    retiredMirror.Attach(_pComposition.Detach());
+  }
+  if (wasCurrent) {
+    _status.composing = false;
+    if (target->cancelled) _committed = TRUE;
+  }
+  if (target->cancelled && _engineResponseIntent.lock() == target && !target->preparing) {
+    m_client.ClearComposition();
+    if (_engineResponseIntent.lock() == target) _engineResponseIntent.reset();
+  }
+  const auto bridge = work ? _EnsureDependencyBridge(work) : nullptr;
+  if (wasCurrent && !_responseIntent && bridge) _responseIntent = bridge;
+  // Submit before any UI callback can produce B. Existing work is idempotent.
+  if (work) _QueueResponse(work);
+  if (candidate) {
+    candidate->CancelUI(target);
+    if (source != target) candidate->CancelUI(source);
+  }
+}
+
+// EndDraft owns native closure. It may remove text only when this service
+// actually wrote that exact inline preedit into the same native composition.
+static HRESULT ClearOwnedInlinePreedit(TfEditCookie ec,
+    const std::shared_ptr<response_owner::Intent>& source,
+    const com_ptr<ITfComposition>& native, const com_ptr<ITfRange>& range,
+    SavedResponseSelection& selection, HRESULT& selectionResult, bool& attempted) {
+  const std::wstring expected = source->inlinePreeditText;
+  if (expected.empty()) return S_OK;  // Non-inline drafts own no document text.
+  const auto owns = [&]() {
+    return source->composition.p == native.p && !source->terminated &&
+        !source->preparing && !source->hasCommit && !source->captureFailed &&
+        source->inlinePreeditText == expected;
+  };
+  if (!owns()) return S_OK;
+  // One extra UTF-16 unit distinguishes an exact match from a matching prefix
+  // that has absorbed host text. No unbounded GetText or null-terminated scan.
+  std::wstring observed(expected.size() + 1, L'\0');
+  ULONG read = 0;
+  HRESULT result = range->GetText(ec, 0, &observed[0],
+      static_cast<ULONG>(observed.size()), &read);
+  if (FAILED(result)) return result;
+  if (result != S_OK || !owns() || read != expected.size() ||
+      observed.compare(0, read, expected) != 0) return S_OK;
+  // Selection preservation cannot withdraw the independently proven clear.
+  selectionResult = selection.Capture(ec, source);
+  if (!owns()) return FAILED(selectionResult) ? selectionResult : S_OK;
+  attempted = true;
+  result = range->SetText(ec, 0, L"", 0);
+  if (result == S_OK && owns()) source->inlinePreeditText.clear();
+  return FAILED(selectionResult) ? selectionResult : result;
+}
+
+HRESULT WeaselTSF::_DeliverEndDraft(
+    const std::shared_ptr<response_owner::Packet>& packet, TfEditCookie ec) {
+  using namespace response_owner;
+  if (!packet || packet->kind != WorkKind::EndDraft || !packet->source)
+    return E_INVALIDARG;
+  if (packet->deliveryStarted || packet->stage != Stage::Closing) return S_FALSE;
+  packet->deliveryStarted = true;
+  const auto source = packet->source;
+  const com_ptr<ITfComposition> native = packet->endComposition;
+  HRESULT cleanup = S_OK;
+  SavedResponseSelection selection;
+  HRESULT selectionResult = E_PENDING;
+  bool attemptedClear = false;
+  if (native && !(source->composition.p == native.p && source->terminated)) {
+    com_ptr<ITfRange> range = packet->endRange;
+    // Inline SetText may have completed after EndDraft captured its point.
+    if (source->composition.p == native.p && !source->inlinePreeditText.empty())
+      range = source->range;
+    if (!range) cleanup = native->GetRange(&range);
+    if (SUCCEEDED(cleanup) && !range) cleanup = E_UNEXPECTED;
+    if (SUCCEEDED(cleanup)) {
+      _ClearCompositionDisplayAttributes(ec, source->owner, range);
+      if (packet->clearRange)
+        cleanup = ClearOwnedInlinePreedit(ec, source, native, range, selection,
+            selectionResult, attemptedClear);
+    }
+  }
+  const HRESULT ended = _CloseResponseComposition(ec, native, source,
+      packet->compositionClosed);
+  if (attemptedClear && selectionResult == S_OK) {
+    const HRESULT restored = selection.Current() ?
+        _SetResponseSelection(ec, source, selection.range, &selection.style) : E_UNEXPECTED;
+    if (SUCCEEDED(cleanup) && FAILED(restored)) cleanup = restored;
+  }
+  packet->cleanupResult = FAILED(cleanup) ? cleanup : ended;
+  packet->stage = SUCCEEDED(packet->cleanupResult) ? Stage::Done : Stage::Failed;
+  return packet->cleanupResult;
+}
+
+
+HRESULT WeaselTSF::_CloseResponseComposition(TfEditCookie ec,
+    com_ptr<ITfComposition> composition,
+    std::shared_ptr<response_owner::Intent> intent, bool& closed) {
+  closed = !composition;
+  if (!composition) return S_OK;
+  const bool matching = intent && intent->composition.p == composition.p;
+  if (matching && intent->terminated) {
+    closed = true;
+    return S_OK;
+  }
+  if (_IsCurrentComposition(composition)) _FinalizeComposition();
+  const HRESULT result = composition->EndComposition(ec);
+  bool observedClosed = false;
+  if (FAILED(result)) {
+    // GetRange has one documented E_UNEXPECTED meaning: already terminated.
+    // This is one observation of the exact object, not another End attempt.
+    com_ptr<ITfRange> observed;
+    observedClosed = composition->GetRange(&observed) == E_UNEXPECTED;
+  }
+  const bool stillMatching = intent && intent->composition.p == composition.p;
+  closed = SUCCEEDED(result) || observedClosed || (stillMatching && intent->terminated);
+  // Mark actual success only after native End returns. Its callback may have
+  // installed B, so never update the service's current intent here.
+  if (closed && stillMatching) intent->terminated = true;
+  return result;
+}
