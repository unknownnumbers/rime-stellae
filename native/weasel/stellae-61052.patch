+STDMETHODIMP CCandidateList::Show(BOOL showCandidateWindow) {
+  PresentationScope scope(this);
+  if (showCandidateWindow) {
+    auto packet = _publishing.lock();
+    if (!packet) packet = _published.lock();
+    if (!_positioned ||
+        (_phase != Phase::Beginning && _phase != Phase::Active) ||
+        !_IsDesired(packet) ||
+        _registeredIntent != packet->outputIntent.lock())
+      return S_FALSE;
+    _ui->Show();
+  } else {
+    // Hiding remains available while retiring or abandoning a registration.
+    _ui->Hide();
+  }
+  return S_OK;
+}
