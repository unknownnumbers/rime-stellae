+#if STELLAE_ENABLE_PROMPT_TRACE
+std::uint64_t WeaselTSF::_PromptTrace(prompt_trace::Stage stage, ITfContext* origin,
+    ITfComposition* captured, std::uint64_t flags, HRESULT result,
+    std::int64_t commit, std::int64_t preedit, int empty, std::uint64_t generation) {
