+  if (FAILED(hr))    \
+  return FALSE
+
+  CComPtr<ITfInputProcessorProfileMgr> pInputProcessorProfileMgr;
+  CHECK_HR(pInputProcessorProfileMgr.CoCreateInstance(
+      CLSID_TF_InputProcessorProfiles, NULL, CLSCTX_ALL));
+  WCHAR szProfile[100];
+  std::wstring profile{};
+  DWORD dwSize = GetEnvironmentVariable(L"TEXTSERVICE_PROFILE", szProfile,
+                                        ARRAYSIZE(szProfile));
+  if (dwSize > 0) {
+    profile = szProfile;
+  }
+  BOOL hansEnable = (profile == L"hans");
+  BOOL hantEnable = (profile == L"hant");
+  // fallback hans enable
+  hansEnable = hansEnable || (!hantEnable && !hansEnable);
+
+  const auto text_service_desc = get_weasel_ime_name();
+  const WCHAR* text_service_desc_str = text_service_desc.c_str();
+  ULONG text_service_desc_len = text_service_desc.size() * sizeof(wchar_t);
+
+  WCHAR achIconFile[MAX_PATH];
+  ULONG cchIconFile =
+      GetModuleFileNameW(g_hInst, achIconFile, ARRAYSIZE(achIconFile));
+
+  const auto register_profile = [&](LANGID langId, HKL hkl, BOOL enable) {
+    return pInputProcessorProfileMgr->RegisterProfile(
+        c_clsidTextService, langId, c_guidProfile, text_service_desc_str,
+        text_service_desc_len, achIconFile, cchIconFile, TEXTSERVICE_ICON_INDEX,
+        hkl, 0, enable, 0);
+  };
+
+  // UI resource language IDs remain independent of the registered TIP region.
+  TF_INPUTPROCESSORPROFILE legacy_profile = {};
+  if (SUCCEEDED(pInputProcessorProfileMgr->GetProfile(
+          TF_PROFILETYPE_INPUTPROCESSOR, STELLAE_LANGID_LEGACY_TC,
+          c_clsidTextService, c_guidProfile, NULL, &legacy_profile))) {
+    CHECK_HR(pInputProcessorProfileMgr->UnregisterProfile(
+        c_clsidTextService, STELLAE_LANGID_LEGACY_TC, c_guidProfile, 0));
+  }
+
+  const auto hkl_hans = FindIME(STELLAE_LANGID_MAINLAND);
+  const auto hkl_hant = FindIME(STELLAE_LANGID_TRADITIONAL);
+  CHECK_HR(register_profile(STELLAE_LANGID_MAINLAND, hkl_hans, hansEnable));
+  CHECK_HR(register_profile(STELLAE_LANGID_TRADITIONAL, hkl_hant, hantEnable));
+  // These additional profiles have no classic IME substitute.
+  CHECK_HR(register_profile(TEXTSERVICE_LANGID_MACAU, NULL, false));
+  CHECK_HR(register_profile(TEXTSERVICE_LANGID_SINGAPORE, NULL, false));
+#undef CHECK_HR
+
+  return TRUE;
+}
+
+void UnregisterProfiles() {
+  CComPtr<ITfInputProcessorProfileMgr> pInputProcessorProfileMgr;
+  if (FAILED(pInputProcessorProfileMgr.CoCreateInstance(
+          CLSID_TF_InputProcessorProfiles, NULL, CLSCTX_ALL)))
+    return;
+  const auto unregister_profile = [&](LANGID id) {
+    pInputProcessorProfileMgr->UnregisterProfile(c_clsidTextService, id,
+                                                 c_guidProfile, 0);
+  };
+  unregister_profile(STELLAE_LANGID_MAINLAND);
+  unregister_profile(STELLAE_LANGID_TRADITIONAL);
+  unregister_profile(STELLAE_LANGID_LEGACY_TC);
+  unregister_profile(TEXTSERVICE_LANGID_MACAU);
+  unregister_profile(TEXTSERVICE_LANGID_SINGAPORE);
+}
+
+const GUID SupportCategories0[] = {
+    GUID_TFCAT_CATEGORY_OF_TIP, GUID_TFCAT_TIP_KEYBOARD,
+    // GUID_TFCAT_TIP_SPEECH,
+    // GUID_TFCAT_TIP_HANDWRITING,
+    GUID_TFCAT_TIPCAP_SECUREMODE, GUID_TFCAT_TIPCAP_UIELEMENTENABLED,
+    GUID_TFCAT_TIPCAP_INPUTMODECOMPARTMENT, GUID_TFCAT_TIPCAP_COMLESS,
+    GUID_TFCAT_TIPCAP_WOW16, GUID_TFCAT_TIPCAP_IMMERSIVESUPPORT,
+    GUID_TFCAT_TIPCAP_SYSTRAYSUPPORT, GUID_TFCAT_PROP_AUDIODATA,
+    GUID_TFCAT_PROP_INKDATA, GUID_TFCAT_PROPSTYLE_CUSTOM,
+    GUID_TFCAT_PROPSTYLE_STATIC, GUID_TFCAT_PROPSTYLE_STATICCOMPACT,
+    GUID_TFCAT_DISPLAYATTRIBUTEPROVIDER, GUID_TFCAT_DISPLAYATTRIBUTEPROPERTY};
+
+BOOL RegisterCategories() {
+  CComPtr<ITfCategoryMgr> pCategoryMgr = NULL;
+  if (FAILED(CoCreateInstance(CLSID_TF_CategoryMgr, NULL, CLSCTX_INPROC_SERVER,
+                              IID_ITfCategoryMgr, (LPVOID*)&pCategoryMgr)))
+    return FALSE;
+  for (const auto& guid : SupportCategories0) {
+    if (FAILED(pCategoryMgr->RegisterCategory(c_clsidTextService, guid,
+                                              c_clsidTextService)))
+      return FALSE;
+  }
+  return TRUE;
+}
+
+void UnregisterCategories() {
+  CComPtr<ITfCategoryMgr> pCategoryMgr = NULL;
+  if (FAILED(CoCreateInstance(CLSID_TF_CategoryMgr, NULL, CLSCTX_INPROC_SERVER,
+                              IID_ITfCategoryMgr, (LPVOID*)&pCategoryMgr)))
+    return;
+  for (const auto& guid : SupportCategories0)
+    pCategoryMgr->UnregisterCategory(c_clsidTextService, guid,
+                                     c_clsidTextService);
+}
+
+static BOOL CLSIDToStringA(REFGUID refGUID, char* pchA) {
+  static const BYTE GuidMap[] = {3,   2, 1, 0,   '-', 5,  4,  '-', 7,  6,
+                                 '-', 8, 9, '-', 10,  11, 12, 13,  14, 15};
+
+  static const char szDigits[] = "0123456789ABCDEF";
+
+  int i;
+  char* p = pchA;
+
+  const BYTE* pBytes = (const BYTE*)&refGUID;
+
+  *p++ = '{';
+  for (i = 0; i < sizeof(GuidMap); i++) {
+    if (GuidMap[i] == '-')
+      *p++ = '-';
+    else {
+      *p++ = szDigits[(pBytes[GuidMap[i]] & 0xF0) >> 4];
+      *p++ = szDigits[(pBytes[GuidMap[i]] & 0x0F)];
+    }
+  }
+  *p++ = '}';
+  *p = '\0';
+  return TRUE;
+}
+
+static LONG RecurseDeleteKeyA(HKEY hParentKey, LPCSTR lpszKey) {
+  HKEY hKey;
+  LONG lRes;
+  FILETIME time;
+  CHAR szBuffer[256];
+  DWORD dwSize = ARRAYSIZE(szBuffer);
+
+  if (RegOpenKeyA(hParentKey, lpszKey, &hKey) != ERROR_SUCCESS)
+    return ERROR_SUCCESS;
+
+  lRes = ERROR_SUCCESS;
+  while (RegEnumKeyExA(hKey, 0, szBuffer, &dwSize, NULL, NULL, NULL, &time) ==
+         ERROR_SUCCESS) {
+    szBuffer[ARRAYSIZE(szBuffer) - 1] = '\0';
+    lRes = RecurseDeleteKeyA(hKey, szBuffer);
+    if (lRes != ERROR_SUCCESS)
+      break;
+    dwSize = ARRAYSIZE(szBuffer);
+  }
+  RegCloseKey(hKey);
+
+  return lRes == ERROR_SUCCESS ? RegDeleteKeyA(hParentKey, lpszKey) : lRes;
+}
+
+BOOL RegisterServer() {
+  DWORD dw;
+  HKEY hKey;
+  HKEY hSubKey;
+  BOOL fRet;
+  char achIMEKey[ARRAYSIZE(c_szInfoKeyPrefix) + CLSID_STRLEN];
+  char achFileName[MAX_PATH];
+
+  if (!CLSIDToStringA(c_clsidTextService,
+                      achIMEKey + ARRAYSIZE(c_szInfoKeyPrefix) - 1))
+    return FALSE;
+  memcpy(achIMEKey, c_szInfoKeyPrefix, sizeof(c_szInfoKeyPrefix) - 1);
+
+  if (fRet = RegCreateKeyExA(HKEY_CLASSES_ROOT, achIMEKey, 0, NULL,
+                             REG_OPTION_NON_VOLATILE, KEY_WRITE, NULL, &hKey,
+                             &dw) == ERROR_SUCCESS) {
+    fRet &= RegSetValueExA(hKey, NULL, 0, REG_SZ, (BYTE*)TEXTSERVICE_DESC_A,
+                           sizeof TEXTSERVICE_DESC_A) == ERROR_SUCCESS;
+    if (fRet &=
+        RegCreateKeyExA(hKey, c_szInProcSvr32, 0, NULL, REG_OPTION_NON_VOLATILE,
+                        KEY_WRITE, NULL, &hSubKey, &dw) == ERROR_SUCCESS) {
+      dw = GetModuleFileNameA(g_hInst, achFileName, ARRAYSIZE(achFileName));
+
+#ifdef _M_ARM64
+      {
+        // On ARM64 we use ARM64X redirection DLL.
+        // When loaded, stellae.dll will be redirected to stellaeARM64.dll on
+        // ARM64 processes, and stellaex64.dll on x64 processes.
+        //
+        // But GetModuleFileNameA will return the actual loaded DLL name aka
+        // stellaeARM64.dll. Rewrite the path to point to the redirector.
+
+        char wrapperPath[MAX_PATH];
+        StringCbCatA(achFileName, MAX_PATH, "\\..\\" STELLAE_TSF_DLL_A);
+        GetFullPathNameA(achFileName, MAX_PATH, wrapperPath, NULL);
+        memcpy(achFileName, wrapperPath, MAX_PATH);
+      }
+#endif
+
+      fRet &= RegSetValueExA(hSubKey, NULL, 0, REG_SZ, (BYTE*)achFileName,
+                             (strlen(achFileName) + 1) * sizeof(char)) ==
+              ERROR_SUCCESS;
+      fRet &= RegSetValueExA(hSubKey, c_szModelName, 0, REG_SZ,
+                             (BYTE*)TEXTSERVICE_MODEL,
+                             sizeof TEXTSERVICE_MODEL) == ERROR_SUCCESS;
+      RegCloseKey(hSubKey);
+    }
+    RegCloseKey(hKey);
+  }
+  return fRet;
+}
+
+void UnregisterServer() {
+  char achIMEKey[ARRAYSIZE(c_szInfoKeyPrefix) + CLSID_STRLEN];
+  if (!CLSIDToStringA(c_clsidTextService,
+                      achIMEKey + ARRAYSIZE(c_szInfoKeyPrefix) - 1))
+    return;
+  memcpy(achIMEKey, c_szInfoKeyPrefix, sizeof(c_szInfoKeyPrefix) - 1);
+  RecurseDeleteKeyA(HKEY_CLASSES_ROOT, achIMEKey);
+
+  // On Windows 8, we need to manually delete the registry key for our TIP
+  char tipKey[ARRAYSIZE(c_szTipKeyPrefix) + CLSID_STRLEN];
+  if (!CLSIDToStringA(c_clsidTextService,
+                      tipKey + ARRAYSIZE(c_szTipKeyPrefix) - 1))
+    return;
+  memcpy(tipKey, c_szTipKeyPrefix, sizeof(c_szTipKeyPrefix) - 1);
+  RecurseDeleteKeyA(HKEY_CLASSES_ROOT, tipKey);
+}
diff --git a/WeaselTSF/ResponseOwner.h b/WeaselTSF/ResponseOwner.h
new file mode 100644
index 0000000000000000000000000000000000000000..6ab46ee736c8ee6134675ef88c059b0a40db26ad
--- /dev/null
+++ b/WeaselTSF/ResponseOwner.h
@@ -0,0 +1,167 @@
+#pragma once
+#include <memory>
+#include <vector>
+#include <cstdint>
+#include <WeaselIPCData.h>
+
+// The registry owns live work and native resources until closed. Completed
+// unused entries are pruned; there is no text history or second work queue.
+namespace response_owner {
+inline bool SameIdentity(IUnknown* left, IUnknown* right) {
+  if (left == right) return left != nullptr;
+  if (!left || !right) return false;
+  com_ptr<IUnknown> a, b;
+  return SUCCEEDED(left->QueryInterface(IID_IUnknown, reinterpret_cast<void**>(&a))) &&
+         SUCCEEDED(right->QueryInterface(IID_IUnknown, reinterpret_cast<void**>(&b))) && a.p == b.p;
+}
+enum class WorkKind { Content, EndDraft };
+enum class Stage {
+  Prepared, AwaitEndpoint, Ready, Writing, Written, Done,
+  NoCommit, Closing, Failed, UnsupportedEndpoint
+};
+struct Packet;
+struct Intent;
+struct SelectionOperation;
+// Shared only by live intents for this context. Notifications and explicit
+// selection operations revoke an in-flight save/restore; this is not inferred
+// from ownSelection's one-shot notification acknowledgement.
+struct SelectionState {
+  std::uint64_t revision = 0;
+  SelectionOperation* active = nullptr;
+  void Notify() { ++revision; }
+  void Revoke();
+};
+// Only an explicit SetSelection call owns this stack cell. A synchronous
+// ACK may acknowledge this call, but never validates an older saved revision.
+struct SelectionOperation {
+  SelectionOperation(SelectionState& state, const Intent* intent)
+      : state(state), previous(state.active), intent(intent) {
+    state.Revoke();
+    state.active = this;
+  }
+  ~SelectionOperation() { state.active = previous; }
+  SelectionOperation(const SelectionOperation&) = delete;
+  SelectionOperation& operator=(const SelectionOperation&) = delete;
+  SelectionState& state;
+  SelectionOperation* previous;
+  const Intent* intent;
+  ITfRange* expected = nullptr;
+  bool revoked = false;
+};
+inline void SelectionState::Revoke() {
+  Notify();
+  if (active) active->revoked = true;
+}
+struct Intent {
+  std::uint64_t token = 0;
+  com_ptr<ITfContext> owner;
+  TfClientId clientId = TF_CLIENTID_NULL;
+  std::shared_ptr<SelectionState> selection = std::make_shared<SelectionState>();
+  com_ptr<ITfComposition> composition;
+  com_ptr<ITfRange> range;
+  // Parent-only ownership: native FIFO orders work; no parent owns followers.
+  std::shared_ptr<Packet> predecessor;
+  std::weak_ptr<Packet> nativeWork;
+  com_ptr<ITfRange> initialPoint;
+  HRESULT initialPointResult = E_PENDING;
+  bool followsCommit = false;
+  // Authority to remove inline preedit comes only from a successful write
+  // to this intent's exact native object, never from current UI style.
+  std::wstring inlinePreeditText;
+  com_ptr<ITfRange> ownSelection;
+  bool initialSelection = true;
+  bool valid = true;
+  bool cancelled = false;
+  bool preparing = false;
+  bool hasCommit = false;
+  bool captureFailed = false;
+  bool terminated = false;
+};
+// Intrusive RAII call stack for active native delivery only. It does not
+// retain queued work, completed history, or another context identity cache.
+struct DeliveryFrame {
+  DeliveryFrame(DeliveryFrame*& top, const std::shared_ptr<Intent>& intent)
+      : slot(top), previous(top), source(intent) { slot = this; }
+  ~DeliveryFrame() { slot = previous; }
+  DeliveryFrame(const DeliveryFrame&) = delete;
+  DeliveryFrame& operator=(const DeliveryFrame&) = delete;
+  DeliveryFrame*& slot;
+  DeliveryFrame* previous;
+  std::shared_ptr<Intent> source;
+};
+struct Response {
+  std::uint64_t generation = 0;
+  std::wstring commit;
+  weasel::Context context;
+  weasel::Status status;
+  weasel::Config config;
+  weasel::UIStyle style;
+};
+struct Packet {
+  std::shared_ptr<Intent> source;
+  std::weak_ptr<Intent> outputIntent;
+  std::shared_ptr<const Response> response;
+  com_ptr<ITfRange> endAnchor;
+  WorkKind kind = WorkKind::Content;
+  com_ptr<ITfComposition> endComposition;
+  com_ptr<ITfRange> endRange;
+  bool clearRange = false;
+  Stage stage = Stage::Prepared;
+  HRESULT captureResult = E_PENDING;
+  HRESULT writeResult = E_PENDING;
+  HRESULT cleanupResult = E_PENDING;
+  unsigned writeAttempts = 0;
+  bool textWritten = false;
+  bool endAnchorValid = false;
+  bool compositionClosed = false;
+  bool scheduled = false;
+  // Prepare decides before engine IPC. Non-engine cleanup stays asynchronous.
+  bool deferNative = true;
+  // Entry guard for the one document delivery, not proof of native/UI success.
+  bool deliveryStarted = false;
+};
+inline bool NativeActionTerminal(const std::shared_ptr<Packet>& work) {
+  return work && work->scheduled &&
+      (work->stage == Stage::Failed || work->stage == Stage::UnsupportedEndpoint ||
+       work->stage == Stage::Written || work->stage == Stage::Done);
+}
+
+// Pure native-order view, not a replacement for a selected commit end anchor.
+// An old terminal P/E may still be named after its exact close moved to new E.
+inline std::shared_ptr<Packet> NativeDependency(std::shared_ptr<Packet> work) {
+  if (!work || work->compositionClosed) return nullptr;
+  if (!NativeActionTerminal(work)) return work;
+  const auto source = work->source;
+  if (!source) return work;
+  if (!source->composition) return NativeDependency(source->predecessor);
+  if (source->terminated) return nullptr;
+  const auto active = source->nativeWork.lock();
+  const bool exactCleanup = active && active->kind == WorkKind::EndDraft &&
+      active->source == source && active->endComposition.p == source->composition.p;
+  if (active && active != work && !exactCleanup) return work;
+  if (exactCleanup) return active->compositionClosed ? nullptr : active;
+  return work;
+}
+
+// Called only by a new producer/abort action, never by request failure or a
+// delivery's return path. It transfers only this native object's remaining
+// close, not selected text, and retains no chain of failed cleanup packets.
+inline std::shared_ptr<Packet> CleanupForAction(
+    std::shared_ptr<Intent> source, std::shared_ptr<Packet> work, bool clear) {
+  work = NativeDependency(work);
+  if (work && !NativeActionTerminal(work)) return work;
+  if (work && work->source) source = work->source;
+  if (!source || !source->composition || source->terminated) return work;
+  const bool clearPrevious = work && work->kind == WorkKind::EndDraft && work->clearRange;
+  auto cleanup = std::make_shared<Packet>();
+  cleanup->kind = WorkKind::EndDraft;
+  cleanup->source = source;
+  cleanup->endComposition = source->composition;
+  cleanup->endRange = source->range;
+  cleanup->clearRange = (clear || clearPrevious) && !source->hasCommit;
+  cleanup->stage = Stage::Closing;
+  source->nativeWork = cleanup;
+  return cleanup;
+}
+
+}  // namespace response_owner
