+void WeaselTSF::ActivationBindings::Disconnect() {
+  // The cell relinquishes its Activate ThreadMgr before any cleanup callout.
+  // Call-local leases in an already executing native call finish separately.
+  com_ptr<ITfThreadMgr> oldThread;
+  oldThread.Attach(thread.Detach());
+  // Keep callback objects alive until the exact old registrations are gone.
+  com_ptr<ITfThreadMgrEventSink> oldThreadSink;
+  com_ptr<ITfThreadFocusSink> oldFocusSink;
+  com_ptr<ITfKeyEventSink> oldKeySink;
+  oldThreadSink.Attach(threadEventsSink.Detach());
+  oldFocusSink.Attach(threadFocusSink.Detach());
+  oldKeySink.Attach(keySink.Detach());
+  _UninitGlobalKeyboardOpen(*this);
+  _UninitThreadMgrEventSink(*this);
+  _UninitKeyEventSink(*this);
+  _UninitLanguageBar(*this);
+  _UninitCompartment(*this);
+  _UninitThreadFocusSink(*this);
+}
