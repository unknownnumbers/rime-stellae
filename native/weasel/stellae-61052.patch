+HRESULT WeaselTSF::SourceSubscription::Disconnect() {
+  const DWORD oldCookie = cookie;
+  cookie = TF_INVALID_COOKIE;
+  com_ptr<ITfSource> oldSource;
+  oldSource.Attach(source.Detach());
+  return oldSource && oldCookie != TF_INVALID_COOKIE ?
+      oldSource->UnadviseSink(oldCookie) : S_OK;
