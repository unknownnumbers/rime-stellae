+STDMETHODIMP CCandidateList::GetPageIndex(UINT* pIndex,
+                                          UINT uSize,
+                                          UINT* puPageCnt) {
+  if (!puPageCnt)
+    return E_INVALIDARG;
+  *puPageCnt = 1;
+  if (pIndex) {
+    if (uSize < *puPageCnt) {
+      return E_INVALIDARG;
+    }
+    *pIndex = 0;
+  }
+  return S_OK;
+}
