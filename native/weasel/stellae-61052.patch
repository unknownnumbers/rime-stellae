+// Remove only layouts owned by this product. A zero language selects all three
+// supported/current-or-legacy regions; only_layout narrows a mismatched API result.
+static LSTATUS remove_stellae_ime_layouts(LANGID language,
+                                         const WCHAR* only_layout = NULL) {
+  HKEY layouts = NULL;
+  LSTATUS ret = RegOpenKeyExW(
+      HKEY_LOCAL_MACHINE,
+      L"SYSTEM\\CurrentControlSet\\Control\\Keyboard Layouts", 0,
+      KEY_READ | KEY_WRITE, &layouts);
+  if (ret == ERROR_FILE_NOT_FOUND)
+    return ERROR_SUCCESS;
+  if (ret != ERROR_SUCCESS)
+    return ret;
+
+  std::vector<std::wstring> remove_keys;
+  for (DWORD i = 0;; ++i) {
+    WCHAR key[16] = {};
+    ret = RegEnumKeyW(layouts, i, key, _countof(key));
+    if (ret == ERROR_NO_MORE_ITEMS)
+      break;
+    if (ret != ERROR_SUCCESS) {
+      RegCloseKey(layouts);
+      return ret;
+    }
+    DWORD id = 0;
+    if (wcslen(key) != 8 || swscanf_s(key, L"%x", &id) != 1)
+      continue;
+    const LANGID langid = LOWORD(id);
+    if (language ? langid != language
+                 : langid != STELLAE_LANGID_MAINLAND &&
+                       langid != STELLAE_LANGID_TRADITIONAL &&
+                       langid != STELLAE_LANGID_LEGACY_TC)
+      continue;
+    if (only_layout && _wcsicmp(key, only_layout) != 0)
+      continue;
+    WCHAR ime_file[MAX_PATH] = {};
+    DWORD size = sizeof(ime_file);
+    if (RegGetValueW(layouts, key, L"Ime File", RRF_RT_REG_SZ, NULL,
+                     ime_file, &size) == ERROR_SUCCESS &&
+        _wcsicmp(ime_file, STELLAE_IME_FILE) == 0)
+      remove_keys.emplace_back(key);
+  }
+
+  // Collect names first so deleting a key cannot skip the next layout.
+  for (const auto& key : remove_keys) {
+    DWORD id = 0;
+    swscanf_s(key.c_str(), L"%x", &id);
+    UnloadKeyboardLayout((HKL)(ULONG_PTR)id);
+    ret = RegDeleteKeyW(layouts, key.c_str());
+    if (ret != ERROR_SUCCESS && ret != ERROR_FILE_NOT_FOUND)
+      break;
+
+    HKEY preload = NULL;
+    ret = RegOpenKeyExW(HKEY_CURRENT_USER, L"Keyboard Layout\\Preload", 0,
+                         KEY_READ | KEY_WRITE, &preload);
+    if (ret == ERROR_FILE_NOT_FOUND) {
+      ret = ERROR_SUCCESS;
+      continue;
+    }
+    if (ret != ERROR_SUCCESS)
+      break;
+    std::vector<std::wstring> remove_values;
+    for (DWORD i = 0;; ++i) {
+      WCHAR name[32] = {}, value[32] = {};
+      DWORD name_size = _countof(name), value_size = sizeof(value), type = 0;
+      LSTATUS item = RegEnumValueW(preload, i, name, &name_size, NULL, &type,
+                                    (LPBYTE)value, &value_size);
+      if (item == ERROR_NO_MORE_ITEMS)
+        break;
+      if (item != ERROR_SUCCESS && item != ERROR_MORE_DATA) {
+        ret = item;
+        break;
+      }
+      if (item == ERROR_SUCCESS && type == REG_SZ &&
+          value_size <= sizeof(value) && value[_countof(value) - 1] == 0 &&
+          _wcsicmp(value, key.c_str()) == 0)
+        remove_values.emplace_back(name);
+    }
+    for (const auto& name : remove_values) {
+      if (ret != ERROR_SUCCESS)
+        break;
+      ret = RegDeleteValueW(preload, name.c_str());
+      if (ret != ERROR_SUCCESS && ret != ERROR_FILE_NOT_FOUND)
+        break;
+      ret = ERROR_SUCCESS;
+    }
+    RegCloseKey(preload);
+    if (ret != ERROR_SUCCESS)
+      break;
+  }
+  RegCloseKey(layouts);
+  return ret == ERROR_NO_MORE_ITEMS ? ERROR_SUCCESS : ret;
+}
