+  *pdwFlags = TF_CLUIE_DOCUMENTMGR | TF_CLUIE_COUNT | TF_CLUIE_SELECTION |
+              TF_CLUIE_STRING | TF_CLUIE_CURRENTPAGE;
+  return S_OK;
+}
