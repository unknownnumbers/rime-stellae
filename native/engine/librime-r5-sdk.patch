diff --git a/src/rime/preedit_spacing.h b/src/rime/preedit_spacing.h
new file mode 100644
index 0000000..c3fbbe9
--- /dev/null
+++ b/src/rime/preedit_spacing.h
@@ -0,0 +1,164 @@
+// Copyright RIME Developers
+// Distributed under the BSD License
+// Display-only spacing for a native candidate's unconsumed input suffix.
+#ifndef RIME_PREEDIT_SPACING_H_
+#define RIME_PREEDIT_SPACING_H_
+
+#include <algorithm>
+#include <string>
+#include <utility>
+#include <vector>
+
+namespace rime {
+namespace preedit_spacing {
+
+struct Plan {
+  size_t start = 0;
+  size_t end = 0;
+  size_t length = 0;
+  size_t caret = 0;
+  std::vector<size_t> breaks;
+};
+
+// All values are zero-based byte boundaries in the unchanged context input:
+// start:end:input_length:caret|break,break,...
+inline bool ReadNumber(const std::string& value,
+                       size_t* offset,
+                       size_t limit,
+                       size_t* result) {
+  size_t begin = *offset, number = 0;
+  while (*offset < value.size() && value[*offset] >= '0' &&
+         value[*offset] <= '9') {
+    size_t digit = value[(*offset)++] - '0';
+    if (digit > limit || number > (limit - digit) / 10)
+      return false;
+    number = number * 10 + digit;
+  }
+  *result = number;
+  return *offset != begin;
+}
+
+inline bool Parse(const std::string& value, size_t length, Plan* plan) {
+  Plan parsed;
+  size_t offset = 0;
+  size_t* fields[] = {&parsed.start, &parsed.end, &parsed.length, &parsed.caret};
+  for (size_t i = 0; i < 4; ++i) {
+    if (!ReadNumber(value, &offset, length, fields[i]) ||
+        offset >= value.size() || value[offset++] != (i == 3 ? '|' : ':'))
+      return false;
+  }
+  while (offset < value.size()) {
+    size_t boundary;
+    if (!ReadNumber(value, &offset, length, &boundary) ||
+        (!parsed.breaks.empty() && boundary <= parsed.breaks.back()))
+      return false;
+    parsed.breaks.push_back(boundary);
+    if (offset == value.size())
+      break;
+    if (value[offset++] != ',' || offset == value.size())
+      return false;
+  }
+  *plan = parsed;
+  return true;
+}
+
+inline bool IsLetter(char c) {
+  return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z');
+}
+
+inline bool IsDelimiter(char c) {
+  return c == ' ' || c == '\'';
+}
+
+// PreeditT has the native Preedit's text/caret_pos/sel_start/sel_end members.
+// No candidate, composition, input or commit object is changed by this helper.
+template <class PreeditT>
+bool Apply(PreeditT* preedit,
+           const std::string& input,
+           size_t candidate_start,
+           size_t candidate_end,
+           size_t caret,
+           const std::string& marker,
+           const std::string& value) {
+  Plan plan;
+  if (!Parse(value, input.size(), &plan) || plan.start != candidate_start ||
+      plan.end != candidate_end || plan.length != input.size() ||
+      plan.caret != caret || plan.start >= plan.end ||
+      plan.end >= input.size() || plan.breaks.empty())
+    return false;
+
+  PreeditT result = *preedit;
+  if (result.caret_pos > result.text.size() ||
+      result.sel_start > result.sel_end || result.sel_end > result.text.size())
+    return false;
+
+  // Composition inserts soft cursor + prompt at caret_pos. Temporarily remove
+  // that known insertion, then restore it after inserting display spaces.
+  if (!marker.empty()) {
+    if (result.text.compare(result.caret_pos, marker.size(), marker) != 0)
+      return false;
+    result.text.erase(result.caret_pos, marker.size());
+    if (result.caret_pos < result.sel_start)
+      result.sel_start -= marker.size();
+    if (result.caret_pos < result.sel_end)
+      result.sel_end -= marker.size();
+  }
+
+  const std::string suffix = input.substr(candidate_end);
+  if (suffix.size() > result.text.size())
+    return false;
+  const size_t suffix_start = result.text.size() - suffix.size();
+  // Only the native appended raw suffix is formatted. Candidate-specific
+  // preedit and already selected text remain byte-for-byte unchanged.
+  if (result.sel_end != suffix_start ||
+      result.text.compare(suffix_start, suffix.size(), suffix) != 0)
+    return false;
+
+  std::vector<size_t> insertions;
+  for (size_t boundary : plan.breaks) {
+    if (boundary < candidate_end || boundary >= input.size() ||
+        !IsLetter(input[boundary]) ||
+        (boundary > candidate_end && !IsLetter(input[boundary - 1])))
+      return false;
+    const size_t at = suffix_start + boundary - candidate_end;
+    if ((at && IsDelimiter(result.text[at - 1])) ||
+        IsDelimiter(result.text[at]))
+      continue;
+    insertions.push_back(at);
+  }
+  if (insertions.empty())
+    return false;
+
+  std::string display;
+  display.reserve(result.text.size() + insertions.size() + marker.size());
+  size_t previous = 0;
+  for (size_t at : insertions) {
+    display.append(result.text, previous, at - previous);
+    display.push_back(' ');
+    previous = at;
+  }
+  display.append(result.text, previous, std::string::npos);
+  // A separator exactly at sel_end is outside the candidate's highlighted
+  // span. The caret points before its raw character, after preceding spaces.
+  result.sel_start += std::lower_bound(insertions.begin(), insertions.end(),
+                                       result.sel_start) - insertions.begin();
+  result.sel_end += std::lower_bound(insertions.begin(), insertions.end(),
+                                     result.sel_end) - insertions.begin();
+  result.caret_pos += std::upper_bound(insertions.begin(), insertions.end(),
+                                       result.caret_pos) - insertions.begin();
+  result.text = std::move(display);
+  if (!marker.empty()) {
+    result.text.insert(result.caret_pos, marker);
+    if (result.caret_pos < result.sel_start)
+      result.sel_start += marker.size();
+    if (result.caret_pos < result.sel_end)
+      result.sel_end += marker.size();
+  }
+  *preedit = std::move(result);
+  return true;
+}
+
+}  // namespace preedit_spacing
+}  // namespace rime
+
+#endif  // RIME_PREEDIT_SPACING_H_
