diff --git a/test/service_release_test.cc b/test/service_release_test.cc
new file mode 100644
index 0000000..cc14c87
--- /dev/null
+++ b/test/service_release_test.cc
@@ -0,0 +1,70 @@
+// Generic lifecycle checks for the production Service notification boundary.
+// Included in upstream test/ by the cloud workflow. No dictionary/user data.
+#include <gtest/gtest.h>
+#include <rime/service.h>
+
+class SessionReleaseTest : public ::testing::Test {
+ protected:
+  void SetUp() override {
+    service = &rime::Service::instance();
+    service->StartService();
+    service->CleanupAllSessions();
+  }
+  void TearDown() override {
+    connection.disconnect();
+    service->CleanupAllSessions();
+  }
+  rime::Service* service;
+  boost::signals2::scoped_connection connection;
+};
+
+TEST_F(SessionReleaseTest, SuccessfulDestroyNotifiesAfterServiceOwnershipRelease) {
+  const auto removed = service->CreateSession();
+  const auto active = service->CreateSession();
+  ASSERT_NE(rime::kInvalidSessionId, removed);
+  ASSERT_NE(rime::kInvalidSessionId, active);
+  std::weak_ptr<rime::Session> removed_ref = service->GetSession(removed);
+  std::weak_ptr<rime::Session> active_ref = service->GetSession(active);
+  int notifications = 0;
+  connection = service->session_release_notifier().connect([&]() {
+    ++notifications;
+    EXPECT_TRUE(removed_ref.expired());
+    EXPECT_FALSE(active_ref.expired());
+    EXPECT_NE(nullptr, service->GetSession(active));
+  });
+  EXPECT_TRUE(service->DestroySession(removed));
+  EXPECT_EQ(1, notifications);
+  EXPECT_FALSE(active_ref.expired());
+}
+
+TEST_F(SessionReleaseTest, InvalidDestroyDoesNotNotify) {
+  int notifications = 0;
+  connection = service->session_release_notifier().connect([&]() { ++notifications; });
+  EXPECT_FALSE(service->DestroySession(rime::kInvalidSessionId));
+  EXPECT_EQ(0, notifications);
+}
+
+TEST_F(SessionReleaseTest, CleanupAllNotifiesOnceAfterTheWholeBatch) {
+  const auto first = service->CreateSession();
+  const auto second = service->CreateSession();
+  ASSERT_NE(rime::kInvalidSessionId, first);
+  ASSERT_NE(rime::kInvalidSessionId, second);
+  std::weak_ptr<rime::Session> first_ref = service->GetSession(first);
+  std::weak_ptr<rime::Session> second_ref = service->GetSession(second);
+  int notifications = 0;
+  connection = service->session_release_notifier().connect([&]() {
+    ++notifications;
+    EXPECT_TRUE(first_ref.expired());
+    EXPECT_TRUE(second_ref.expired());
+  });
+  service->CleanupAllSessions();
+  EXPECT_EQ(1, notifications);
+}
+
+TEST_F(SessionReleaseTest, EmptyCleanupBatchesDoNotNotify) {
+  int notifications = 0;
+  connection = service->session_release_notifier().connect([&]() { ++notifications; });
+  service->CleanupAllSessions();
+  service->CleanupStaleSessions();
+  EXPECT_EQ(0, notifications);
+}
