+      stage == prompt_trace::MouseHoverReturned || stage == prompt_trace::ThreadFocusReturned) {
+    prompt_trace::Lengths lengths;
+    if (generation != 0 && m_client.GetResponseData([&](LPWSTR data, UINT count) {
+          return prompt_trace::CountBody(data, count, lengths);
+        })) { commit = lengths.commit; preedit = lengths.preedit; }
+  }
+  return recorder.Emit(stage, this, origin, _pEditSessionContext.p, captured,
+      _pComposition.p, generation, commit, preedit, flags, empty, result);
+  } catch (...) { prompt_trace::Get().Fail(); return 0; }
+}
+void WeaselTSF::_PromptTraceRange(prompt_trace::Stage stage, TfEditCookie ec,
+    ITfContext* origin, ITfComposition* captured, ITfRange* range, std::uint64_t flags) {
+  prompt_trace::LastErrorGuard preserve;
+  try {
