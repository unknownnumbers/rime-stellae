+STDAPI WeaselTSF::OnKeyDown(ITfContext* context, WPARAM key, LPARAM info, BOOL* eaten) {
+  const auto activation = _activation;
+  return _HandleKeyCallback(activation, activation ? activation->keyState : nullptr,
+      context, key, info, false, false, eaten);
+}
